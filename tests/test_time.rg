        c6 = lt_eq "time_epoch_to_utc (0 - 2) gives the fields of 1969-12-31T23:59:58Z" (time_t_fields (time_epoch_to_utc (0 - 2))) "1969 12 31 23 59 58"
        c7 = lt_eq "time_format_iso8601 (0 - 2)" (time_format_iso8601 (0 - 2)) "1969-12-31T23:59:58Z"
