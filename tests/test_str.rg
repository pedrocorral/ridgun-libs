-- test_str.rg — str against its contract (FR-STR-001, API-STR-001) with bytes the library's own tests don't use:
-- NUL, bytes >= 0x80 and UTF-8 text, round trips, and time in the size of the input.
-- Generated by tests/gen/make_str.py. Lists are shown as "[a][b]…", so lost or extra empty items show.

import test
import str
import posix
import crypto
import lt

fn :: str_t_range Int Int [Int] => [Int]
      str_t_range i n acc =
        | i >= n    = acc
        | otherwise = str_t_range (i + 1) n (acc :: [i])

fn :: str_t_list [String] => String
      str_t_list []     =  ""
      str_t_list (x:xs) =  "[" + x + "]" + (str_t_list xs)

fn :: str_t_count [String] => String
      str_t_count xs =  int_to_str (str_t_len xs 0)

fn :: str_t_len [String] Int => Int
      str_t_len []     n =  n
      str_t_len (_:xs) n =  str_t_len xs (n + 1)

-- Built from lines, without str_repeat or str_join, so the setup doesn't depend on what is measured.
fn :: str_t_lines Int [String] => [String]
      str_t_lines n acc =
        | n <= 0    = acc
        | otherwise = str_t_lines (n - 1) (acc :: ["Some TEXT with Code, café & a [Link](https://example.org)."])

fn :: str_t_glue [String] String => String
      str_t_glue []     acc =  acc
      str_t_glue (x:xs) acc =  str_t_glue xs (acc + x + "\n")

fn :: main => ()
      main =
        c0 = lt_int "str_index_of: needle at the start" (str_index_of "abc" "a") 0
        c1 = lt_int "str_index_of: needle at the end" (str_index_of "abc" "c") 2
        c2 = lt_int "str_index_of: first of two" (str_index_of "abab" "b") 1
        c3 = lt_int "str_index_of: not found is -1" (str_index_of "abc" "x") (0 - 1)
        c4 = lt_int "str_index_of: needle longer than the text is -1" (str_index_of "ab" "abc") (0 - 1)
        c5 = lt_int "str_index_of: empty needle is 0" (str_index_of "abc" "") 0
        c6 = lt_int "str_index_of: empty text, empty needle is 0" (str_index_of "" "") 0
        c7 = lt_int "str_index_of: empty text is -1" (str_index_of "" "a") (0 - 1)
        c8 = lt_int "str_index_of: byte index after a two-byte é" (str_index_of (bytes_from_list [99, 97, 102, 195, 169, 33]) "!") 5
        c9 = lt_int "str_index_of: finds a multi-byte needle" (str_index_of (bytes_from_list [110, 97, 195, 175, 118, 101]) (bytes_from_list [195, 175])) 2
        c10 = lt_int "str_index_of: finds a NUL byte" (str_index_of (bytes_from_list [97, 98, 0, 99, 100]) (bytes_from_list [0])) 2
        c11 = lt_int "str_index_of: finds a byte >= 0x80 in binary data" (str_index_of (bytes_from_list [1, 2, 255, 3]) (bytes_from_list [255])) 2
        c12 = lt_eq "str_trim: spaces, tabs, CR and LF at both ends" (str_trim (bytes_from_list [9, 10, 32, 120, 32, 121, 32, 13, 10])) "x y"
        c13 = lt_eq "str_trim: only whitespace gives \"\"" (str_trim (bytes_from_list [32, 9, 13, 10, 32])) ""
        c14 = lt_hex "str_trim: inner whitespace stays" (str_trim (bytes_from_list [97, 32, 32, 9, 32, 98])) "612020092062"
        c15 = lt_hex "str_trim: NUL is not whitespace" (str_trim (bytes_from_list [0, 97, 0])) "006100"
        c16 = lt_eq "str_trim: a no-break space (C2 A0) is not ASCII whitespace" (str_trim (bytes_from_list [194, 160, 97, 194, 160])) " a "
        c17 = lt_eq "str_trim: UTF-8 text stays whole" (str_trim (bytes_from_list [32, 195, 177, 97, 110, 100, 195, 186, 32])) "ñandú"
        c18 = lt_eq "str_replace: non-overlapping, left to right" (str_replace "aaaa" "aa" "b") "bb"
        c19 = lt_eq "str_replace: odd count leaves the rest" (str_replace "aaa" "aa" "b") "ba"
        c20 = lt_eq "str_replace: empty old leaves s unchanged" (str_replace "abc" "" "x") "abc"
        c21 = lt_eq "str_replace: deleting" (str_replace "a-b-c" "-" "") "abc"
        c22 = lt_eq "str_replace: new contains old: no rescan" (str_replace "aaa" "a" "aa") "aaaaaa"
        c23 = lt_eq "str_replace: multi-byte old" (str_replace (bytes_from_list [195, 169, 120, 195, 169]) (bytes_from_list [195, 169]) "e") "exe"
        c24 = lt_eq "str_replace: NUL bytes are replaced too" (str_replace (bytes_from_list [97, 0, 98, 0]) (bytes_from_list [0]) "_") "a_b_"
        c25 = lt_hex "str_replace: bytes >= 0x80 are kept around matches" (str_replace (bytes_from_list [255, 45, 254]) "-" "+") "ff2bfe"
        c26 = lt_eq "str_replace: old longer than s" (str_replace "ab" "abc" "x") "ab"
        c27 = lt_eq "str_split: keeps empty segments" (str_t_list (str_split "a,,b" ",")) "[a][][b]"
        c28 = lt_eq "str_split: separators at both ends" (str_t_list (str_split ",a," ",")) "[][a][]"
        c29 = lt_eq "str_split: \"\" gives [\"\"] (FR-STR-001)" (str_t_list (str_split "" ",")) "[]"
        c30 = lt_eq "str_split: no separator gives the whole text" (str_t_list (str_split "abc" ",")) "[abc]"
        c31 = lt_eq "str_split: multi-byte separator" (str_t_list (str_split "a::b::" "::")) "[a][b][]"
        c32 = lt_eq "str_split: separator longer than the text" (str_t_list (str_split "ab" "abc")) "[ab]"
        c33 = lt_eq "str_split: UTF-8 separator" (str_t_list (str_split (bytes_from_list [97, 195, 169, 98]) (bytes_from_list [195, 169]))) "[a][b]"
        c34 = lt_eq "str_split: UTF-8 text around an ASCII separator" (str_t_list (str_split (bytes_from_list [195, 177, 44, 195, 188]) ",")) "[ñ][ü]"
        c35 = lt_eq "str_join (str_split s sep) sep == s for \"a,,b,\"" (str_join (str_split "a,,b," ",") ",") "a,,b,"
        c36 = lt_eq "str_join (str_split s sep) sep == s for \",\"" (str_join (str_split "," ",") ",") ","
        c37 = lt_eq "str_join (str_split s sep) sep == s for \"\"" (str_join (str_split "" ",") ",") ""
        c38 = lt_eq "str_join (str_split s sep) sep == s for \"x::y\"" (str_join (str_split "x::y" "::") "::") "x::y"
        c39 = lt_eq "str_join (str_split s sep) sep == s for (bytes_from_list [99, 97, 102, 195, 169, 44, 116, 104, 195, 169])" (str_join (str_split (bytes_from_list [99, 97, 102, 195, 169, 44, 116, 104, 195, 169]) ",") ",") (bytes_from_list [99, 97, 102, 195, 169, 44, 116, 104, 195, 169])
        c40 = lt_eq "str_join [] gives \"\"" (str_join [] ",") ""
        c41 = lt_eq "str_join of one item adds no separator" (str_join ["a"] ",") "a"
        c42 = lt_eq "str_join keeps empty items" (str_join ["", "", ""] ",") ",,"
        c43 = lt_hex "str_to_upper of every byte 0..255 changes only a-z" (str_to_upper (bytes_from_list (str_t_range 0 256 []))) ""
        c44 = lt_hex "str_to_lower of every byte 0..255 changes only A-Z" (str_to_lower (bytes_from_list (str_t_range 0 256 []))) ""
        c45 = lt_eq "str_to_upper leaves UTF-8 letters as they are" (str_to_upper "ñandú é") "ñANDú é"
        c46 = lt_eq "str_repeat: 3 times" (str_repeat "ab" 3) "ababab"
        c47 = lt_eq "str_repeat: 0 times" (str_repeat "ab" 0) ""
        c48 = lt_eq "str_repeat: negative count" (str_repeat "ab" (0 - 2)) ""
        c49 = lt_eq "str_repeat: empty text" (str_repeat "" 5) ""
        c50 = lt_hex "str_repeat: bytes >= 0x80" (str_repeat (bytes_from_list [255]) 3) "ffffff"
        c51 = lt_eq "str_pad_left to width 3 with 0" (str_pad_left "7" 3 "0") "007"
        c52 = lt_eq "str_pad_right to width 4 with ." (str_pad_right "ab" 4 ".") "ab.."
        c53 = lt_eq "str_pad_left: width not above the length leaves it" (str_pad_left "abcd" 2 "0") "abcd"
        small_parts = str_t_lines 340 []
        big_parts = str_t_lines 3400 []
        small = str_t_glue small_parts ""
        big = str_t_glue big_parts ""
        s0 = sys_monotonic_ms
        _ = str_len (str_replace small "\r\n" "\n")
        m0 = sys_monotonic_ms
        _ = str_len (str_replace big "\r\n" "\n")
        e0 = sys_monotonic_ms
        t0 = lt_linear "str_replace (nothing to replace): 20 KB then 200 KB in linear time, 200 KB under 2 s" (m0 - s0) (e0 - m0) 10 2000
        s1 = sys_monotonic_ms
        _ = str_len (str_to_lower small)
        m1 = sys_monotonic_ms
        _ = str_len (str_to_lower big)
        e1 = sys_monotonic_ms
        t1 = lt_linear "str_to_lower: 20 KB then 200 KB in linear time, 200 KB under 2 s" (m1 - s1) (e1 - m1) 10 2000
        s2 = sys_monotonic_ms
        _ = str_len (str_to_upper small)
        m2 = sys_monotonic_ms
        _ = str_len (str_to_upper big)
        e2 = sys_monotonic_ms
        t2 = lt_linear "str_to_upper: 20 KB then 200 KB in linear time, 200 KB under 2 s" (m2 - s2) (e2 - m2) 10 2000
        s3 = sys_monotonic_ms
        _ = str_len (str_join small_parts "\n")
        m3 = sys_monotonic_ms
        _ = str_len (str_join big_parts "\n")
        e3 = sys_monotonic_ms
        t3 = lt_linear "str_join (2 000 then 20 000 parts): 20 KB then 200 KB in linear time, 200 KB under 2 s" (m3 - s3) (e3 - m3) 10 2000
        s4 = sys_monotonic_ms
        _ = str_len (str_t_count (str_split small "\n"))
        m4 = sys_monotonic_ms
        _ = str_len (str_t_count (str_split big "\n"))
        e4 = sys_monotonic_ms
        t4 = lt_linear "str_split: 20 KB then 200 KB in linear time, 200 KB under 2 s" (m4 - s4) (e4 - m4) 10 2000
        s5 = sys_monotonic_ms
        _ = str_len (int_to_str (str_index_of small "zzz"))
        m5 = sys_monotonic_ms
        _ = str_len (int_to_str (str_index_of big "zzz"))
        e5 = sys_monotonic_ms
        t5 = lt_linear "str_index_of (not found): 20 KB then 200 KB in linear time, 200 KB under 2 s" (m5 - s5) (e5 - m5) 10 2000
        s6 = sys_monotonic_ms
        _ = str_len (str_trim ("  " + small + "  "))
        m6 = sys_monotonic_ms
        _ = str_len (str_trim ("  " + big + "  "))
        e6 = sys_monotonic_ms
        t6 = lt_linear "str_trim: 20 KB then 200 KB in linear time, 200 KB under 2 s" (m6 - s6) (e6 - m6) 10 2000
        lt_done "str" [c0, c1, c2, c3, c4, c5, c6, c7, c8, c9, c10, c11, c12, c13, c14, c15, c16, c17, c18, c19, c20, c21, c22, c23, c24, c25, c26, c27, c28, c29, c30, c31, c32, c33, c34, c35, c36, c37, c38, c39, c40, c41, c42, c43, c44, c45, c46, c47, c48, c49, c50, c51, c52, c53, t0, t1, t2, t3, t4, t5, t6]
