-- ============================================================
-- src/test/ridgun/test csv.ridgun
-- Comprehensive test suite for csv.ridgun inspired by rust-csv & Go encoding/csv (RFC 4180)
-- @tests TS-CSV-001
-- ============================================================

import test
import csv

fn :: csv p key (String String) => String
      csv p key (k, _)          =  k

fn :: csv p val (String String) => String
      csv p val (_, v)          =  v

fn :: csv pair val [String String] String => String
      csv pair val []              _      =  ""
      csv pair val (pair:rest)     key
        | (csv p key pair) == key = csv p val pair
        | otherwise = csv pair val rest key

fn :: csv len [String] => Int
      csv len []       =  0
      csv len (_:xs)   =  1 + (csv len xs)

fn :: csv row count [[String]] => Int
      csv row count []         =  0
      csv row count (_:rs)     =  1 + (csv row count rs)

fn :: csv cell at [[String]] Int Int => String
      csv cell at [] _ _ = ""
      csv cell at (r:_) 0 c = csv str at r c
      csv cell at (_:rs) r c = csv cell at rs (r - 1) c

fn :: csv str at [String] Int => String
      csv str at []       _   =  ""
      csv str at (x:_)    0   =  x
      csv str at (_:xs)   c   =  csv str at xs (c - 1)

-- 1. RFC 4180 CSV & TSV round-trip with quoted commas, escaped quotes, and multiline cells
-- @tests TS-CSV-001
fn :: test csv tsv roundtrip => ()
      test csv tsv roundtrip =
        nl = char from code 10
        tab = char from code 9
        raw_csv = "name,role,note" + nl + "Ada,\"Admin, Lead\",\"Quote \"\"here\"\"\"" + nl + "Bob,User,\"Line 1" + nl + "Line 2\"" + nl
        parsed = csv parse raw_csv
        _ = assert int equals (csv row count parsed) 3 "AC1: 3 rows parsed including multiline quoted cell"
        _ = assert str eq (csv cell at parsed 1 1) "Admin, Lead" "AC1: quoted comma preserved"
        _ = assert str eq (csv cell at parsed 1 2) "Quote \"here\"" "AC1: doubled quote unescaped"
        _ = assert str eq (csv cell at parsed 2 2) ("Line 1" + nl + "Line 2") "AC1: embedded newline in quoted cell preserved"
        re_csv = csv stringify parsed
        _ = assert str eq re_csv raw_csv "AC1/AC2: RFC 4180 CSV quoted comma, escaped quote, and newline round-trip"

        raw_tsv = "col1" + tab + "col2" + nl + "val,1" + tab + "val2" + nl
        parsed_tsv = tsv parse raw_tsv
        _ = assert str eq (csv cell at parsed_tsv 1 0) "val,1" "AC1: TSV unquoted comma preserved"
        re_tsv = tsv stringify parsed_tsv
        _ = assert str eq re_tsv raw_tsv "AC1/AC2: TSV round-trip"
        ()

-- 2. CRLF (\r\n) line endings, empty cells, trailing delimiters, and custom delimiter (; / |)
-- @tests TS-CSV-001
fn :: test csv crlf and empty cells => ()
      test csv crlf and empty cells =
        cr = char from code 13
        nl = char from code 10
        crlf = cr + nl
        raw_crlf = "a,b,c" + crlf + "1,,3" + crlf + ",2," + crlf
        rows_crlf = csv parse raw_crlf
        _ = assert int equals (csv row count rows_crlf) 3 "AC1: CRLF row count"
        _ = assert str eq (csv cell at rows_crlf 1 0) "1" "AC1: cell (1,0)"
        _ = assert str eq (csv cell at rows_crlf 1 1) "" "AC1: middle empty cell (1,1)"
        _ = assert str eq (csv cell at rows_crlf 1 2) "3" "AC1: cell (1,2)"
        _ = assert str eq (csv cell at rows_crlf 2 0) "" "AC1: leading empty cell (2,0)"
        _ = assert str eq (csv cell at rows_crlf 2 1) "2" "AC1: cell (2,1)"
        _ = assert str eq (csv cell at rows_crlf 2 2) "" "AC1: trailing empty cell (2,2)"

        semi_rows = csv parse with delim ("k1;k2" + nl + "v1;v2" + nl) ";"
        _ = assert int equals (csv row count semi_rows) 2 "AC1: semicolon delimiter row count"
        _ = assert str eq (csv cell at semi_rows 1 1) "v2" "AC1: semicolon delimiter cell (1,1)"
        _ = assert int equals (csv row count (csv parse "")) 0 "AC1: empty input yields 0 rows"
        ()

-- 3. Header-indexed tables, headerless tables, column extraction, and row-to-map
-- @tests TS-CSV-001
fn :: test csv table lookup => ()
      test csv table lookup =
        nl = char from code 10
        raw_csv = "id,name,dept" + nl + "10,Ada,Math" + nl + "20,Grace,Compilers" + nl
        tbl = csv parse table raw_csv True
        _ = assert true (has_headers tbl) "AC3: table has_headers True"
        _ = assert int equals (csv len (headers tbl)) 3 "AC3: 3 headers extracted"
        _ = assert str eq (csv get by header tbl 0 "name") "Ada" "AC3: csv get by header row 0"
        _ = assert str eq (csv get by header tbl 1 "dept") "Compilers" "AC3: csv get by header row 1"
        _ = assert str eq (csv get by header tbl 0 "missing") "" "AC3: csv get by header missing column"
        _ = assert str eq (csv get by header tbl 99 "name") "" "AC3: csv get by header out-of-bounds row"

        tbl_no_h = csv parse table raw_csv False
        _ = assert false (has_headers tbl_no_h) "AC3: table has_headers False"
        _ = assert int equals (csv row count (rows tbl_no_h)) 3 "AC3: headerless table keeps all 3 rows"

        names = csv col (rows tbl) 1
        _ = assert int equals (csv len names) 2 "AC3: csv col length"
        _ = assert str eq (csv str at names 0) "Ada" "AC3: csv col[0]"
        _ = assert str eq (csv str at names 1) "Grace" "AC3: csv col[1]"

        rmap = csv row to map ["id", "name", "dept"] ["10", "Ada", "Math"]
        _ = assert str eq (csv pair val rmap "id") "10" "AC3: csv row to map id"
        _ = assert str eq (csv pair val rmap "name") "Ada" "AC3: csv row to map name"
        _ = assert str eq (csv pair val rmap "dept") "Math" "AC3: csv row to map dept"
        ()

-- @tests TS-CSV-001
fn :: main => ()
      main =
        _ = test csv tsv roundtrip
        _ = test csv crlf and empty cells
        _ = test csv table lookup
        echo "[PASS] test csv: TS-CSV-001 passed"
