-- ============================================================
-- src/test/ridgun/test list.ridgun
-- Comprehensive test suite for list.ridgun inspired by Rust std::slice & Haskell Data.List
-- Covers RG-066 (importing `list` and `agent` together without name collisions)
-- @tests TS-LIST-001
-- @tests TS-LIST-002
-- ============================================================

import test
import list
import agent

-- 1. Indexing, slicing (`take`, `drop`, `slice`), reversal, ranges, search, and deduplication on [Int] & [String]
-- @tests TS-LIST-001
fn :: test list indexing slicing and ranges => ()
      test list indexing slicing and ranges =
        xs = [10, 20, 30, 40, 50]
        ss = ["aa", "bb", "cc", "dd"]
        _ = assert int equals (list len xs) 5 "AC1: list_len 5"
        _ = assert int equals (list str len ss) 4 "AC1: list_str_len 4"
        _ = assert true (list is empty []) "AC1: list_is_empty []"
        _ = assert false (list is empty xs) "AC1: list_is_empty non-empty"
        _ = assert true (list str is empty []) "AC1: list_str_is_empty []"
        _ = assert false (list str is empty ss) "AC1: list_str_is_empty non-empty"

        _ = assert int equals (list nth xs 0) 10 "AC1: list_nth 0"
        _ = assert int equals (list nth xs 4) 50 "AC1: list_nth 4"
        _ = assert int equals (list nth or xs 99 (0 - 1)) (0 - 1) "AC1: list_nth_or out of bounds"
        _ = assert int equals (list nth or xs (0 - 1) (0 - 1)) (0 - 1) "AC1: list_nth_or negative"
        _ = assert str eq (list str nth ss 2) "cc" "AC1: list_str_nth 2"
        _ = assert str eq (list str nth or ss 99 "oob") "oob" "AC1: list_str_nth_or out of bounds"
        _ = assert int equals (list head xs 0) 10 "AC1: list_head"
        _ = assert int equals (list head [] 99) 99 "AC1: list_head empty fallback"
        _ = assert int equals (list last xs 0) 50 "AC1: list_last"
        _ = assert int equals (list last [] 99) 99 "AC1: list_last empty fallback"

        _ = assert eq (list take xs 3) [10, 20, 30]
        _ = assert eq (list take xs 0) []
        _ = assert eq (list take xs (0 - 2)) []
        _ = assert eq (list take xs 99) [10, 20, 30, 40, 50]
        _ = assert eq (list drop xs 3) [40, 50]
        _ = assert eq (list drop xs 0) xs
        _ = assert eq (list drop xs 99) []
        _ = assert eq (list slice xs 1 4) [20, 30, 40]
        _ = assert eq (list slice xs (0 - 3) 2) [10, 20]
        _ = assert eq (list slice xs 4 2) []
        _ = assert eq (list str slice ss 1 3) ["bb", "cc"]

        _ = assert eq (list reverse xs) [50, 40, 30, 20, 10]
        _ = assert eq (list str reverse ss) ["dd", "cc", "bb", "aa"]

        _ = assert eq (list range 1 5) [1, 2, 3, 4, 5]
        _ = assert eq (list range 3 3) [3]
        _ = assert eq (list range 5 1) []
        _ = assert eq (list range step 0 6 2) [0, 2, 4, 6]
        _ = assert eq (list range step 6 0 (0 - 2)) [6, 4, 2, 0]
        _ = assert eq (list range step 1 5 0) []
        _ = assert eq (list replicate 3 7) [7, 7, 7]
        _ = assert eq (list replicate 0 7) []

        _ = assert true (list contains xs 30) "AC1: list_contains 30"
        _ = assert false (list contains xs 99) "AC1: list_contains 99"
        _ = assert true (list str contains ss "cc") "AC1: list_str_contains cc"
        _ = assert false (list str contains ss "zz") "AC1: list_str_contains zz"
        _ = assert int equals (list index of xs 30) 2 "AC1: list_index_of 30"
        _ = assert int equals (list index of xs 99) (0 - 1) "AC1: list_index_of missing"
        _ = assert int equals (list str index of ss "dd") 3 "AC1: list_str_index_of dd"
        _ = assert int equals (list count [1, 2, 1, 3, 1] 1) 3 "AC1: list_count"
        _ = assert int equals (list str count ["a", "b", "a"] "a") 2 "AC1: list_str_count"
        _ = assert eq (list dedup [3, 1, 3, 2, 1, 3]) [3, 1, 2]
        _ = assert eq (list str dedup ["b", "a", "b", "c", "a"]) ["b", "a", "c"]
        ()

-- 2. Deterministic O(N log N) mergesort on ascending, descending, duplicate, negative, and prefix-sharing inputs
-- @tests TS-LIST-001
fn :: test list mergesort => ()
      test list mergesort =
        unsorted = [42, 7, 19, 7, 0, (0 - 5), 100, 3, (0 - 50)]
        sorted = list sort unsorted
        _ = assert eq sorted [(0 - 50), (0 - 5), 0, 3, 7, 7, 19, 42, 100]
        _ = assert true (list is sorted sorted) "AC2: list_is_sorted after sort"
        _ = assert false (list is sorted unsorted) "AC2: list_is_sorted false on unsorted"
        _ = assert true (list is sorted []) "AC2: empty list is sorted"
        _ = assert true (list is sorted [1]) "AC2: singleton list is sorted"
        _ = assert eq (list sort []) []
        _ = assert eq (list sort [1]) [1]
        _ = assert eq (list sort [5, 4, 3, 2, 1]) [1, 2, 3, 4, 5]
        s_strs = list str sort ["delta", "alpha", "charlie", "bravo", "alpha", "al", ""]
        _ = assert eq s_strs ["", "al", "alpha", "alpha", "bravo", "charlie", "delta"]
        ()

-- 3. Associative key-value map (`list kv *`) CRUD, order preservation, multi-key merge, and RG-066 coexistence with `agent`
-- @tests TS-LIST-001
fn :: test kv associative map => ()
      test kv associative map =
        m0 = list kv empty
        _ = assert int equals (list kv len m0) 0 "AC3: list_kv_empty len 0"
        m1 = list kv put m0 "host" "127.0.0.1"
        m2 = list kv put m1 "port" "8080"
        m3 = list kv put m2 "port" "9090"
        _ = assert int equals (list kv len m3) 2 "AC3: list_kv_put updates in-place without duplicating key"
        _ = assert true (list kv has m3 "host") "AC3: list_kv_has host"
        _ = assert false (list kv has m3 "missing") "AC3: list_kv_has missing"
        _ = assert str eq (list kv get m3 "port") "9090" "AC3: list_kv_get updated port"
        _ = assert str eq (list kv get m3 "missing") "" "AC3: list_kv_get missing returns empty"
        _ = assert str eq (list kv get or m3 "mode" "prod") "prod" "AC3: list_kv_get_or default"
        _ = assert eq (list kv keys m3) ["host", "port"]
        _ = assert eq (list kv values m3) ["127.0.0.1", "9090"]
        m4 = list kv merge m3 [("port", "8443"), ("tls", "true")]
        _ = assert int equals (list kv len m4) 3 "AC3: list_kv_merge len 3"
        _ = assert str eq (list kv get m4 "port") "8443" "AC3: list_kv_merge overrides port"
        _ = assert str eq (list kv get m4 "tls") "true" "AC3: list_kv_merge adds tls"
        m5 = list kv remove m4 "host"
        _ = assert false (list kv has m5 "host") "AC3: list_kv_remove removes host"
        _ = assert int equals (list kv len m5) 2 "AC3: list_kv_remove len 2"

        -- RG-066: verify `agent kv *` and `list kv *` work side-by-side in the same module
        ag = new kv agent
        _  = assert str eq (agent kv put ag "host" (list kv get m4 "port")) "8443" "RG-066: agent kv put + list kv get"
        _  = assert str eq (agent kv get ag "host") "8443" "RG-066: agent kv get"
        _  = stop agent ag
        ()

-- ── TS-LIST-002: sorting, counting and grouping by key ──────

type Entry = name: String, score: Int

fn :: rep text String Int => String
      rep text s n =
        | n <= 0    = ""
        | otherwise = s + (rep text s (n - 1))

fn :: kb10 String => String
      kb10 last = (rep text (rep text "k" 100) 100) + last

fn :: gen ints Int Int [Int] => [Int]
      gen ints i n acc =
        | i >= n    = acc
        | otherwise = gen ints (i + 1) n ([((i * 1103515245 + 12345) % 2147483648) - 1073741824] :: acc)

fn :: gen entries Int Int [Entry] => [Entry]
      gen entries i n acc =
        | i >= n    = acc
        | otherwise = gen entries (i + 1) n ([Entry (int to str i) ((i * 7919) % 1000)] :: acc)

fn :: ascending ints [Int] => Bool
      ascending ints []      = True
      ascending ints (_:[])  = True
      ascending ints (a:b:r) =
        | a > b     = False
        | otherwise = ascending ints ([b] :: r)

-- Equal scores keep the original order: the names, generated in descending
-- order, must then be descending within each score.
fn :: stable entries [Entry] => Bool
      stable entries []      = True
      stable entries (_:[])  = True
      stable entries (a:b:r) =
        | score a > score b                                            = False
        | score a == score b and str to int (name a) < str to int (name b) = False
        | otherwise                                                    = stable entries ([b] :: r)

fn :: sum counts [String Int] Int => Int
      sum counts []            acc = acc
      sum counts ((_, c):rest) acc = sum counts rest (acc + c)

-- @tests TS-LIST-002
fn :: test list sort by key => ()
      test list sort by key =
        big   = 9223372036854775807
        small = 0 - 9223372036854775807 - 1
        _ = assert eq (list sort ints []) []
        _ = assert eq (list sort ints [7]) [7]
        _ = assert eq (list sort ints [3, 0 - 1, big, 0, small, 0 - 65536, 65536, 2, 2]) [small, 0 - 65536, 0 - 1, 0, 2, 2, 3, 65536, big]

        hi  = char from code 200
        hi2 = char from code 255
        long_a = kb10 "a"
        long_b = kb10 "b"
        _ = assert eq (list sort texts []) []
        _ = assert eq (list sort texts ["b", hi, "", "a", "ab", "a", hi2]) ["", "a", "a", "ab", "b", hi, hi2]
        _ = assert eq (list sort texts [long_b, "z", long_a]) [long_a, long_b, "z"]
        _ = assert eq (list sort [3, 1, 2]) [1, 2, 3]
        _ = assert eq (list str sort ["b", "a"]) ["a", "b"]

        es = [Entry "a" 2, Entry "b" 1, Entry "c" 2, Entry "d" 1]
        _ = assert eq (list sort by int es (e => score e)) [Entry "b" 1, Entry "d" 1, Entry "a" 2, Entry "c" 2]
        _ = assert eq (list sort by text es (e => int to str (score e))) [Entry "b" 1, Entry "d" 1, Entry "a" 2, Entry "c" 2]
        _ = assert eq (list sort by text [Entry hi 1, Entry "" 2, Entry "a" 3, Entry "" 4] (e => name e)) [Entry "" 2, Entry "" 4, Entry "a" 3, Entry hi 1]
        _ = assert eq (list sort by int [] (e => score e)) []
        _ = assert eq (list sort by text [] (e => name e)) []

        calls = Tensor[Int * 1]
        _ = list sort by int es (e =>
          calls_(0) = calls_(0) + 1
          score e
        )
        _ = assert int equals calls_(0) 4 "AC3: key function called once per element"

        n  = 100000
        xs = list sort ints (gen ints 0 n [])
        _ = assert true (ascending ints xs) "AC6: 100k ints ascending"
        _ = assert int equals (list len xs) n "AC6: 100k ints keep every element"
        ys = list sort by int (gen entries 0 n []) (e => score e)
        _ = assert true (stable entries ys) "AC6: 100k records ascending and stable"
        ()

-- @tests TS-LIST-002
fn :: test list count and group by => ()
      test list count and group by =
        hi = char from code 200
        long_a = kb10 "a"
        long_b = kb10 "b"
        words = ["x", "y", "x", "", hi, long_a, "x", "", long_b, hi]
        counts = list count by words (w => w)
        _ = assert eq counts [("x", 3), ("y", 1), ("", 2), (hi, 2), (long_a, 1), (long_b, 1)]
        _ = assert int equals (sum counts counts 0) 10 "AC4: counts add up to the length"
        _ = assert eq (list count by [] (w => w)) []

        es = [Entry "a" 2, Entry "b" 1, Entry "c" 2, Entry "d" 1, Entry "e" 3]
        _ = assert eq (list group by es (e => int to str (score e))) [("2", [Entry "a" 2, Entry "c" 2]), ("1", [Entry "b" 1, Entry "d" 1]), ("3", [Entry "e" 3])]
        _ = assert eq (list group by words (w => w)) [("x", ["x", "x", "x"]), ("y", ["y"]), ("", ["", ""]), (hi, [hi, hi]), (long_a, [long_a]), (long_b, [long_b])]
        _ = assert eq (list group by [] (e => name e)) []

        big = list count by (gen entries 0 20000 []) (e => int to str (score e))
        _ = assert int equals (list len (map ((k c) => c) big)) 1000 "AC4: 1000 distinct keys"
        _ = assert int equals (sum counts big 0) 20000 "AC4: counts add up to 20000"
        ()

-- @tests TS-LIST-001
-- @tests TS-LIST-002
fn :: main => ()
      main =
        _ = test list indexing slicing and ranges
        _ = test list mergesort
        _ = test kv associative map
        _ = test list sort by key
        _ = test list count and group by
        echo "[PASS] test list: TS-LIST-001 (including RG-066) and TS-LIST-002 passed"
