-- ============================================================
-- src/test/ridgun/test_posix.ridgun
-- Automated test suite for the POSIX system library (POSIX)
-- @tests TS-POSIX-001
-- @tests TS-POSIX-002
-- @tests TS-POSIX-003
-- @tests TS-POSIX-004
-- @tests TS-POSIX-005
-- ============================================================

import test
import posix
import io
import socket

fn :: is poll timeout PollStatus  => Bool
      is poll timeout PollTimeout =  True
      is poll timeout _           =  False

fn :: is poll ready PollStatus    => Bool
      is poll ready (PollReady _) =  True
      is poll ready _             =  False

fn :: is poll error PollStatus    => Bool
      is poll error (PollError _) =  True
      is poll error _             =  False

fn :: tuple3 status (Int Int Int) => Int
      tuple3 status (st, _, _)    =  st

fn :: tuple3 rfd (Int Int Int) => Int
      tuple3 rfd (_, rfd, _)   =  rfd

fn :: tuple3 wfd (Int Int Int) => Int
      tuple3 wfd (_, _, wfd)   =  wfd

fn :: pair fst (A B)  => A
      pair fst (a, _) =  a

fn :: pair snd (A B)  => B
      pair snd (_, b) =  b

fn :: bytes len Tensor[U8] => Int
      bytes len (Tensor[U8 * n] t) =  n

-- Seconds of `CLOCK_REALTIME` read straight from the kernel (`clock_gettime(0, &ts)`).
fn :: kernel wall sec => Int
      kernel wall sec =
        ts = Tensor[U8 * 16]
        sys call (nr clock gettime) 0 ts 0 0 0 0
        px get u64 le ts 0

fn :: ns increasing Int Int Int => Bool
      ns increasing prev i   n   =
        | i >= n = True
        | otherwise = ns increasing step prev i n (sys time ns)

fn :: ns increasing step Int Int Int Int => Bool
      ns increasing step prev i   n   cur =
        | cur < prev = False
        | otherwise  = ns increasing cur (i + 1) n

-- @tests TS-POSIX-001
fn :: test posix constants descriptors and poll => ()
      test posix constants descriptors and poll =
        poll in -> assert equals 1 "POLLIN == 1"
        poll -> assert equals out 4 "POLLOUT == 4"
        poll err -> assert equals 8 "POLLERR == 8"
        sig int -> assert equals 2 "SIGINT == 2"
        sig kill -> assert equals 9 "SIGKILL == 9"
        sig term -> assert equals 15 "SIGTERM == 15"
        o rdonly -> assert equals 0 "O_RDONLY == 0"
        o wronly -> assert equals 1 "O_WRONLY == 1"
        o rdwr -> assert equals 2 "O_RDWR == 2"
        o creat -> assert equals 64 "O_CREAT == 64"
        o trunc -> assert equals 512 "O_TRUNC == 512"
        o append -> assert equals 1024 "O_APPEND == 1024"
        o nonblock -> assert equals 2048 "O_NONBLOCK == 2048"
        o cloexec -> assert equals 524288 "O_CLOEXEC == 524288"
        bad_p   = wait fd (0 - 1) (poll in) 10
        is poll error bad_p -> assert true "wait fd on -1 returns PollError"
        p_res   = posix pipe
        tuple3 status p_res -> assert equals 0 "posix pipe status == 0"
        rfd     = tuple3 rfd p_res
        wfd     = tuple3 wfd p_res
        p_to    = wait fd rfd (poll in) 20
        is poll timeout p_to -> assert true "wait fd on empty pipe times out"
        written = posix write wfd "hello-posix"
        written -> assert equals 11 "posix write 11 bytes"
        p_rdy   = wait fd rfd (poll in) 100
        is poll ready p_rdy -> assert true "wait fd after write is PollReady"
        got     = posix read rfd 64
        got -> assert equals "hello-posix" "posix read matches written payload"
        posix close rfd -> assert equals 0 "posix close rfd"
        assert equals (posix close wfd) 0 "posix close wfd"

-- @tests TS-POSIX-002
fn :: test posix filesystem clocks signals and random => ()
      test posix filesystem clocks signals and random =
        my_pid  = sys getpid
        dir_p   = "/tmp/rg_posix_test_{my_pid}"
        f1      = "{dir_p}/a.txt"
        f2      = "{dir_p}/b.txt"
        lnk     = "{dir_p}/sym.txt"
        sys rmdir dir_p
        posix mkdir dir_p -> assert true "posix mkdir"
        write file f1 "payload"
        posix chmod f1 420 -> assert true "posix chmod 0644"
        sys rename f1 f2 -> assert true "sys rename a.txt -> b.txt"
        sys symlink f2 lnk -> assert true "sys symlink"
        sys readlink lnk -> assert equals f2 "sys readlink target"
        sys unlink lnk -> assert true "sys unlink symlink"
        sys unlink f2 -> assert true "sys unlink b.txt"
        sys rmdir dir_p -> assert true "sys rmdir"
        deep    = "{dir_p}/x/y/z"
        posix mkdir all deep 448 -> assert int equals 0 "posix mkdir all makes the directory and its parents"
        posix mkdir all deep 448 -> assert int equals 0 "posix mkdir all on a directory that is there"
        posix mkdir all "{dir_p}//x/y/" 448 -> assert int equals 0 "posix mkdir all with empty parts in the path"
        (posix mkdir all "" 448) < 0 -> assert true "posix mkdir all rejects an empty path"
        sys rmdir deep -> assert true "the deepest directory existed"
        sys rmdir "{dir_p}/x/y"
        sys rmdir "{dir_p}/x"
        sys rmdir dir_p -> assert true "the first parent existed"
        (sys getpid) > 0 -> assert true "sys_getpid > 0"
        (str len (sys getcwd)) > 0 -> assert true "sys_getcwd non-empty"
        t1      = sys monotonic ms
        n1      = sys time ns
        m1      = sys monotonic ns
        w1      = sys wall time ms
        sys sleep ms 25
        t2      = sys monotonic ms
        n2      = sys time ns
        m2      = sys monotonic ns
        w2      = sys wall time ms
        (t2 - t1) >= 20 -> assert true "monotonic ms elapsed >= 20"
        n2 > n1 -> assert true "sys time ns increases"
        (n2 - n1) >= 20000000 -> assert true "sys time ns elapsed >= 20ms (20,000,000 ns)"
        (m2 - m1) >= 20000000 -> assert true "sys monotonic ns elapsed >= 20ms"
        ns increasing (sys time ns) 0 10000 -> assert true "sys time ns never goes back over 10000 reads"
        w1 > 1700000000000 -> assert true "wall time > 1700000000000"
        w1 < 4102444800000 -> assert true "wall time < 2100-01-01"
        k_sec   = kernel wall sec
        w_sec   = w2 / 1000
        ((w_sec - k_sec) <= 2) and ((k_sec - w_sec) <= 2) -> assert true "sys wall time ms matches kernel clock_gettime(REALTIME) within 2s"
        (w2 - w1) >= 20 -> assert true "wall time ms elapsed >= 20"
        sw_bad  = sys signal watch [9]
        pair fst sw_bad -> assert equals (0 - 7) "SIGKILL watch rejected with -7"
        sw_ok   = sys signal watch [sig term]
        pair fst sw_ok -> assert equals 0 "SIGTERM watch ok"
        sh      = pair snd sw_ok
        (sys call (nr fcntl) sh 1 0 0 0 0) >= 0 -> assert true "signalfd handle is real kernel fd"
        sys kill (sys getpid) (sig term) -> assert equals 0 "real kernel sys_kill SIGTERM does not kill process"
        sw_got  = sys signal wait sh 100
        pair fst sw_got -> assert equals 0 "sys_signal_wait status 0 after real sys_kill"
        pair snd sw_got -> assert equals (sig term) "sys_signal_wait got real SIGTERM (15)"
        posix notify signal (sys getpid) (sig term) -> assert equals 0 "notify signal"
        sw_got2 = sys signal wait sh 100
        pair fst sw_got2 -> assert equals 0 "sys_signal_wait status 0"
        pair snd sw_got2 -> assert equals (sig term) "sys_signal_wait got SIGTERM"
        sw_to   = sys signal wait sh 20
        pair fst sw_to -> assert equals (0 - 2) "second sys_signal_wait times out (-2)"
        posix close sh -> assert equals 0 "posix close signalfd"
        pair fst (sys signal wait sh 10) -> assert equals (0 - 7) "sys_signal_wait on closed fd -> -7"
        r_bad   = sys random bytes (0 - 1)
        pair fst r_bad -> assert equals (0 - 7) "negative random bytes -> -7"
        r_zero  = sys random bytes 0
        pair fst r_zero -> assert equals 0 "0 random bytes -> 0"
        pair snd r_zero -> assert equals "" "0 random bytes -> empty"
        r1      = sys random bytes 32
        r2      = sys random bytes 32
        rt      = sys random tensor 256
        pair fst r1 -> assert equals 0 "random 32 status 0"
        str len (pair snd r1) -> assert equals 32 "random 32 length == 32"
        pair fst rt -> assert equals 0 "random tensor 256 status 0"
        bytes len (pair snd rt) -> assert equals 256 "random tensor 256 length == 256"
        bytes len (pair snd (sys random tensor 0)) -> assert equals 0 "random tensor 0 is empty"
        pair fst (sys random tensor (0 - 1)) -> assert equals (0 - 7) "random tensor -1 -> -7"
        pair fst (sys random tensor 65537) -> assert equals (0 - 7) "random tensor over 64 KiB -> -7"
        path separator Linux -> assert equals "/" "path separator Linux"
        path separator Windows -> assert equals "\\" "path separator Windows"
        null device for Linux -> assert equals "/dev/null" "null device Linux"
        null device for Windows -> assert equals "NUL" "null device Windows"
        process exists (sys getpid) -> assert true "process exists self"
        process exists 99999999 -> assert false "process exists non-existent pid"
        assert false ((pair snd r1) == (pair snd r2)) "two 32-byte random draws differ"

fn :: is proc exited ProcStatus        Int => Bool
      is proc exited (ProcExited code) exp =  code == exp
      is proc exited _                 _   =  False

fn :: run child echo Int Int => Int
      run child echo rfd wfd =
        posix close rfd
        posix dup2 wfd 1
        posix close wfd
        posix execve "/bin/echo" ["/bin/echo", "-n", "hello; $WORLD `safe`"] ["WORLD=injected"]
        posix exit 127

fn :: handle fork branch Int Int Int => ()
      handle fork branch pid rfd wfd =
        | pid == 0 =
          run child echo rfd wfd
          ()
        | otherwise =
          pid > 0 -> assert true "posix fork returns child pid > 0"
          posix close wfd
          w_res = posix waitpid pid 0
          pair fst w_res -> assert equals pid "posix waitpid returns child pid"
          st    = waitpid decode status (pair snd w_res)
          is proc exited st 0 -> assert true "waitpid decode status -> ProcExited 0"
          out   = posix read rfd 128
          posix close rfd
          assert equals out "hello; $WORLD `safe`" "posix execve passes literal argv without shell interpretation"

fn :: test posix fork pipe dup2 execve waitpid => ()
      test posix fork pipe dup2 execve waitpid =
        wnohang -> assert equals 1 "WNOHANG == 1"
        wuntraced -> assert equals 2 "WUNTRACED == 2"
        p_res   = posix pipe
        tuple3 status p_res -> assert equals 0 "posix pipe status == 0"
        rfd     = tuple3 rfd p_res
        wfd     = tuple3 wfd p_res
        handle fork branch (posix fork) rfd wfd

fn :: child lock probe String => ()
      child lock probe path   =
        fd = posix open path (o rdwr) 0
        rc = posix lock exclusive fd
        posix exit (0 - rc)
        ()

fn :: parent lock check Int Int => ()
      parent lock check pid t0  =
        w_res = posix waitpid pid 0
        st    = waitpid decode status (pair snd w_res)
        is proc exited st (errno ewouldblock) -> assert true "second process gets EWOULDBLOCK (exit 11)"
        assert true (((sys monotonic ms) - t0) < 1000) "second process did not wait for the lock"

fn :: handle lock fork Int String Int => ()
      handle lock fork pid path   t0  =
        | pid == 0  = child lock probe path
        | otherwise = parent lock check pid t0

-- @tests TS-POSIX-003
fn :: test posix durable file ops => ()
      test posix durable file ops =
        px sys nr X86_64 75 83 -> assert equals 75 "picker: x86_64 number"
        px sys nr Arm64 75 83 -> assert equals 83 "picker: arm64 number"
        o directory for X86_64 -> assert equals 65536 "O_DIRECTORY x86_64"
        o directory for Arm64 -> assert equals 16384 "O_DIRECTORY arm64"
        nr fdatasync -> assert equals (px sys nr (sys arch) 75 83) "fdatasync nr matches the host arch"
        nr fsync -> assert equals (px sys nr (sys arch) 74 82) "fsync nr matches the host arch"
        nr ftruncate -> assert equals (px sys nr (sys arch) 77 46) "ftruncate nr matches the host arch"
        nr flock -> assert equals (px sys nr (sys arch) 73 32) "flock nr matches the host arch"
        nr pread64 -> assert equals (px sys nr (sys arch) 17 67) "pread64 nr matches the host arch"
        my_pid = sys getpid
        dir_p  = "/tmp/rg_posix_dur_{my_pid}"
        f_dat  = "{dir_p}/f.dat"
        f_lock = "{dir_p}/lock"
        f_r    = "{dir_p}/r.dat"
        posix mkdir dir_p -> assert true "mkdir durable test dir"
        fd     = posix open f_dat ((o creat) + (o rdwr) + (o trunc)) 420
        fd >= 0 -> assert true "open f.dat"
        posix write fd "0123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789" -> assert equals 100 "write 100 bytes"
        posix fdatasync fd -> assert equals 0 "fdatasync on fresh write -> 0"
        posix fsync fd -> assert equals 0 "fsync on fresh write -> 0"
        posix close fd -> assert equals 0 "close f.dat"
        posix fdatasync fd -> assert equals (0 - errno ebadf) "fdatasync on closed fd -> -EBADF"
        posix fsync fd -> assert equals (0 - errno ebadf) "fsync on closed fd -> -EBADF"
        posix fdatasync (0 - 1) -> assert equals (0 - 9) "fdatasync on -1 -> -9"
        fd2    = posix open f_dat (o rdwr) 0
        file size f_dat -> assert equals 100 "file size before truncate"
        posix ftruncate fd2 40 -> assert equals 0 "ftruncate to 40 -> 0"
        file size f_dat -> assert equals 40 "file size after truncate == 40"
        posix ftruncate fd2 (0 - 1) -> assert equals (0 - errno einval) "ftruncate negative -> -EINVAL"
        posix close fd2
        posix sync dir dir_p -> assert equals 0 "sync dir on directory -> 0"
        posix sync dir f_dat -> assert equals (0 - errno enotdir) "sync dir on file -> -ENOTDIR"
        (posix sync dir "{dir_p}/missing") < 0 -> assert true "sync dir on missing path -> error"
        write file f_lock "x"
        la     = posix open f_lock (o rdwr) 0
        lb     = posix open f_lock (o rdwr) 0
        posix lock exclusive la -> assert equals 0 "first lock -> 0"
        posix lock exclusive lb -> assert equals (0 - errno ewouldblock) "second open file -> -EWOULDBLOCK"
        t0     = sys monotonic ms
        handle lock fork (posix fork) f_lock t0
        posix unlock la -> assert equals 0 "unlock -> 0"
        posix lock exclusive lb -> assert equals 0 "lock after unlock -> 0"
        posix close la
        posix close lb
        write file f_r "0123456789ABCDEFGHIJ"
        rf     = posix open f_r (o rdonly) 0
        posix read rf 3 -> assert equals "012" "read 3 moves position to 3"
        p1     = posix pread rf 10 5
        pair fst p1 -> assert equals 5 "pread 5 bytes"
        pair snd p1 -> assert equals "ABCDE" "pread [10,15)"
        p2     = posix pread rf 15 100
        pair fst p2 -> assert equals 5 "pread short read at end"
        pair snd p2 -> assert equals "FGHIJ" "pread [15,20)"
        p3     = posix pread rf 20 4
        pair fst p3 -> assert equals 0 "pread at EOF -> 0"
        pair snd p3 -> assert equals "" "pread at EOF -> empty"
        posix read rf 2 -> assert equals "34" "pread kept the descriptor position"
        pair fst (posix pread rf (0 - 1) 4) -> assert equals (0 - errno einval) "pread negative offset -> -EINVAL"
        pair fst (posix pread rf 0 (0 - 1)) -> assert equals (0 - errno einval) "pread negative length -> -EINVAL"
        pair fst (posix pread rf 0 16777217) -> assert equals (0 - errno einval) "pread over 16 MiB -> -EINVAL"
        pair fst (posix pread rf 0 0) -> assert equals 0 "pread length 0 -> 0"
        posix close rf
        z      = px raw byte 0
        ff     = px raw byte 255
        hi     = px raw byte 128
        bin    = "{z}{ff}{z}A{hi}{ff}{z}Z"
        str len bin -> assert equals 8 "binary fixture is 8 bytes"
        bf     = posix open "{dir_p}/b.dat" ((o creat) + (o wronly) + (o trunc)) 420
        posix write bf bin -> assert equals 8 "write 8 binary bytes"
        posix close bf
        bf2    = posix open "{dir_p}/b.dat" (o rdonly) 0
        pb     = posix pread bf2 1 6
        posix close bf2
        got    = pair snd pb
        pair fst pb -> assert equals 6 "pread 6 binary bytes"
        got -> assert equals (str slice bin 1 7) "pread binary [1,7) matches"
        str char at got 0 -> assert equals 255 "pread keeps 0xFF"
        str char at got 1 -> assert equals 0 "pread keeps 0x00"
        str char at got 3 -> assert equals 128 "pread keeps 0x80"
        str char at got 5 -> assert equals 0 "pread keeps trailing 0x00"
        sys unlink "{dir_p}/b.dat"
        pair fst (posix pread 99999 0 4) -> assert equals (0 - errno ebadf) "pread on unopened fd -> -EBADF"
        pair fst (posix pread (0 - 1) 0 4) -> assert equals (0 - errno ebadf) "pread on -1 -> -EBADF"
        errno eio -> assert equals 5 "EIO == 5"
        errno enospc -> assert equals 28 "ENOSPC == 28"
        sys unlink f_dat
        sys unlink f_lock
        sys unlink f_r
        assert true (sys rmdir dir_p) "remove durable test dir"

fn :: is digit code Int => Bool
      is digit code c   =  c >= 48 and c <= 57

-- True when `line` has `sys call ` followed by a digit before any `--` comment.
fn :: has literal sys call String Int => Bool
      has literal sys call line   i   =
        | (i + 10) > (str len line)                                                   = False
        | (str slice line i (i + 2)) == "--"                                          = False
        | (str slice line i (i + 9)) == "sys call " and is digit code (str char at line (i + 9)) = True
        | otherwise                                                                   = has literal sys call line (i + 1)

fn :: count literal sys calls [String] => Int
      count literal sys calls []       =  0
      count literal sys calls (l:rest) =
        | has literal sys call l 0 = 1 + (count literal sys calls rest)
        | otherwise                = count literal sys calls rest

fn :: check no literal sys calls [String] => ()
      check no literal sys calls []       =  ()
      check no literal sys calls (f:rest) =
        count literal sys calls (io read lines "src/main/ridgun/lib/{f}.ridgun") -> assert equals 0 "no literal sys call number in {f}.ridgun"
        check no literal sys calls rest

fn :: exit child Int => ()
      exit child code =
        posix exit code
        ()

fn :: sleep child => ()
      sleep child =
        sys sleep ms 5000
        posix exit 0
        ()

fn :: reap status Int => ProcStatus
      reap status pid =
        w_res = posix waitpid pid 0
        pair fst w_res -> assert equals pid "waitpid returns the child pid"
        waitpid decode status (pair snd w_res)

fn :: fork exit code Int => ProcStatus
      fork exit code code =  fork exit branch (posix fork) code

fn :: fork exit branch Int Int  => ProcStatus
      fork exit branch pid code =
        | pid == 0  = fork exit in child code
        | otherwise = reap status pid

fn :: fork exit in child Int => ProcStatus
      fork exit in child code =
        exit child code
        ProcExited 0

fn :: fork killed => ProcStatus
      fork killed =  fork killed branch (posix fork)

fn :: fork killed branch Int => ProcStatus
      fork killed branch pid =
        | pid == 0  = fork killed in child
        | otherwise = fork kill and reap pid

fn :: fork killed in child => ProcStatus
      fork killed in child =
        sleep child
        ProcExited 0

fn :: fork kill and reap Int => ProcStatus
      fork kill and reap pid =
        posix kill pid (sig kill)
        reap status pid

fn :: is proc signal ProcStatus       Int => Bool
      is proc signal (ProcSignal sig) exp =  sig == exp
      is proc signal _                _   =  False

-- @tests TS-POSIX-004
fn :: test posix kernel bridge => ()
      test posix kernel bridge =
        check no literal sys calls ["posix", "socket", "uuid", "argon2id", "io", "crypto", "tls", "mail"]
        is proc exited (fork exit code 11) 11 -> assert true "exit 11 decodes to ProcExited 11"
        is proc exited (fork exit code 0) 0 -> assert true "exit 0 decodes to ProcExited 0"
        is proc signal fork killed 9 -> assert true "SIGKILL decodes to ProcSignal 9"
        at fdcwd -> assert equals (0 - 100) "AT_FDCWD == -100"
        p_res = posix pipe
        rfd   = tuple3 rfd p_res
        wfd   = tuple3 wfd p_res
        posix dup2 rfd rfd -> assert equals rfd "dup2 fd fd on an open fd returns fd"
        posix dup2 99999 99999 -> assert equals (0 - errno ebadf) "dup2 fd fd on a closed fd -> -EBADF"
        posix close rfd
        assert equals (posix close wfd) 0 "close bridge pipe"

-- ── TS-POSIX-005: waiting on many descriptors at once ──────
fn :: wm count [Int]    Int => Int
      wm count []       n   =  n
      wm count (_:rest) n   =  wm count rest (n + 1)

fn :: wm same [Int]  [Int]  => Bool
      wm same []     []     =  True
      wm same (a:ar) (b:br) =  (a == b) and (wm same ar br)
      wm same _      _      =  False

fn :: wm has [Int]    Int => Bool
      wm has []       _   =  False
      wm has (x:rest) v   =  (x == v) or (wm has rest v)

-- `n` pipes: the read ends and the write ends, in the order they were made.
fn :: wm pipes Int [Int] [Int] => [Int] [Int]
      wm pipes n   rs    ws    =
        | n <= 0    = (rs, ws)
        | otherwise = wm pipes more (posix pipe) n rs ws

fn :: wm pipes more (Int Int Int) Int [Int] [Int] => [Int] [Int]
      wm pipes more (rc, r, w)    n   rs    ws    =  wm pipes (n - 1) (rs :: [r]) (ws :: [w])

-- One byte into every second descriptor of the list (the 1st, 3rd, ...); returns how many were written.
fn :: wm write odd [Int]    Int Int => Int
      wm write odd []       i   n   =  n
      wm write odd (w:rest) i   n   =
        | (i % 2) == 0 = wm write odd rest (i + 1) (n + (posix write w "x"))
        | otherwise    = wm write odd rest (i + 1) n

-- Every second element of the list, from the first.
fn :: wm odd [Int]    Int => [Int]
      wm odd []       i   =  []
      wm odd (x:rest) i   =
        | (i % 2) == 0 = [x] :: (wm odd rest (i + 1))
        | otherwise    = wm odd rest (i + 1)

fn :: wm take [Int]    Int => [Int]
      wm take []       n   =  []
      wm take (x:rest) n   =
        | n <= 0    = []
        | otherwise = [x] :: (wm take rest (n - 1))

fn :: wm close all [Int]    => ()
      wm close all []       =  ()
      wm close all (x:rest) =
        posix close x
        wm close all rest

-- @tests TS-POSIX-005
fn :: test posix wait on many descriptors => ()
      test posix wait on many descriptors =
        -- AC2: nothing to wait for
        t0 = sys monotonic ms
        e0 = posix wait many [] [] 60
        t1 = sys monotonic ms
        wm count (wm_read e0) 0 -> assert equals 0 "no descriptors: nothing to read"
        wm count (wm_write e0) 0 -> assert equals 0 "nothing to write"
        wm count (wm_failed e0) 0 -> assert equals 0 "nothing failed"
        (t1 - t0) >= 50 -> assert true "with both lists empty it waits for the time limit"
        (t1 - t0) < 2000 -> assert true "and not much longer"

        pa = posix pipe
        pb = posix pipe
        pc = posix pipe
        ra = tuple3 rfd pa
        wa = tuple3 wfd pa
        rb = tuple3 rfd pb
        wb = tuple3 wfd pb
        rc = tuple3 rfd pc
        wc = tuple3 wfd pc
        t2 = sys monotonic ms
        e1 = posix wait many [ra, rb, rc] [] 0
        wm count (wm_read e1) 0 -> assert equals 0 "three empty pipes, limit 0: none is ready"
        e2 = posix wait many [ra, rb, rc] [] 60
        t3 = sys monotonic ms
        wm count (wm_read e2) 0 -> assert equals 0 "three empty pipes, 60 ms: none is ready"
        (t3 - t2) >= 50 -> assert true "the call waited for the limit"
        e3 = posix wait many [ra] [] (0 - 5)
        wm count (wm_read e3) 0 -> assert equals 0 "a limit under 0 answers at once"

        -- AC1: every ready descriptor is named, in the order given, and nothing is read
        posix write wb "bb" -> assert equals 2 "write to the second pipe"
        posix write wc "c" -> assert equals 1 "write to the third pipe"
        t4 = sys monotonic ms
        e4 = posix wait many [ra, rb, rc] [] 5000
        t5 = sys monotonic ms
        wm same (wm_read e4) [rb, rc] -> assert true "the two pipes with bytes are named, in the order given"
        (t5 - t4) < 1000 -> assert true "and the call returns at once, not after the 5 s limit"
        wm count (wm_failed e4) 0 -> assert equals 0 "nothing failed"
        e5 = posix wait many [rc, ra, rb] [] 0
        wm same (wm_read e5) [rc, rb] -> assert true "the order of the answer is the order of the call"
        posix read rb 16 -> assert equals "bb" "the wait read nothing: the bytes are still there"
        e6 = posix wait many [ra, rb, rc] [] 0
        wm same (wm_read e6) [rc] -> assert true "after reading the second pipe only the third is ready"

        -- to write, and a descriptor in both lists
        e7 = posix wait many [ra] [wa, wb] 0
        wm same (wm_write e7) [wa, wb] -> assert true "the write ends of pipes with room are ready to write"
        wm count (wm_read e7) 0 -> assert equals 0 "and the empty pipe is not ready to read"
        e8 = posix wait many [rc, wa] [wa, rc] 0
        wm same (wm_read e8) [rc] -> assert true "a descriptor in both lists: the read end is ready to read"
        wm same (wm_write e8) [wa] -> assert true "and the write end is ready to write"

        -- AC3: closed, not a descriptor, under 0, other end gone
        pd = posix pipe
        rd = tuple3 rfd pd
        wd = tuple3 wfd pd
        posix close rd
        e9 = posix wait many [rd, rc, 999999, 0 - 1, ra] [wd, wa] 0
        wm same (wm_failed e9) [rd, 999999, 0 - 1, wd] -> assert true "the closed descriptor, the one that is none, the one under 0 and the write end whose reader is gone are named as failed"
        wm same (wm_read e9) [rc] -> assert true "and the others are still answered: to read"
        wm same (wm_write e9) [wa] -> assert true "and to write"
        e10 = posix wait many [rd] [rd] 0
        wm same (wm_failed e10) [rd] -> assert true "a failed descriptor in both lists is named once"
        posix close wa
        e11 = posix wait many [ra] [] 0
        wm same (wm_read e11) [ra] -> assert true "a pipe whose writer closed is ready to read (its end)"
        wm count (wm_failed e11) 0 -> assert equals 0 "and not failed"

        -- AC4: a listening socket, a signal descriptor and connected sockets in one call
        l_res = sys tcp listen "127.0.0.1" 0 16
        lfd   = sock fd l_res
        sw    = sys signal watch [sig usr1]
        sfd   = pair snd sw
        pair fst sw -> assert equals 0 "signal watch"
        e12 = posix wait many [lfd, sfd, rc] [] 0
        wm same (wm_read e12) [rc] -> assert true "nobody connected, no signal: only the pipe is ready"
        cfd   = sock fd (sys tcp connect "127.0.0.1" (sys local port lfd) 500)
        e13 = posix wait many [lfd, sfd] [] 2000
        wm same (wm_read e13) [lfd] -> assert true "a client connected: the listening socket is ready"
        afd   = sock accept fd (sys accept lfd 500)
        sys kill (sys getpid) (sig usr1) -> assert equals 0 "send the signal"
        e14 = posix wait many [lfd, sfd, afd] [cfd] 2000
        wm same (wm_read e14) [sfd] -> assert true "the signal descriptor is ready; the listener and the idle connection are not"
        wm same (wm_write e14) [cfd] -> assert true "and the client socket is ready to write"
        pair fst (sys send cfd "hi" 500) -> assert equals 0 "the client sends"
        e15 = posix wait many [lfd, afd] [] 2000
        wm same (wm_read e15) [afd] -> assert true "the connection with bytes is ready"
        posix close cfd
        e16 = posix wait many [afd] [] 2000
        wm same (wm_read e16) [afd] -> assert true "and it stays ready when the client closes"
        posix close afd
        posix close lfd
        posix close sfd

        -- AC5: 1 024 entries in one call: 400 pipes, their read ends (and 224 of them again) and their write ends
        many = wm pipes 400 [] []
        rs   = pair fst many
        ws   = pair snd many
        wm count rs 0 -> assert equals 400 "400 pipes"
        wm write odd ws 0 0 -> assert equals 200 "a byte into every second pipe"
        ins  = rs :: (wm take rs 224)
        wm count ins 0 -> assert equals 624 "624 entries to read"
        e17  = posix wait many ins ws 0
        wm count (wm_failed e17) 0 -> assert equals 0 "1 024 entries: none failed"
        wm same (wm_read e17) ((wm odd rs 0) :: (wm take (wm odd rs 0) 112)) -> assert true "the 200 pipes with a byte are named, and the 112 of them given twice are named twice"
        wm same (wm_write e17) ws -> assert true "and all 400 write ends are ready"
        wm close all rs
        wm close all ws
        e18  = posix wait many rs ws 0
        wm count (wm_failed e18) 0 -> assert equals 800 "after closing them all 800 are named as failed"

        posix close ra
        posix close rb
        posix close wb
        posix close rc
        posix close wc
        posix close wd -> ()

fn :: main => ()
      main =
        test posix constants descriptors and poll
        test posix filesystem clocks signals and random
        test posix fork pipe dup2 execve waitpid
        test posix durable file ops
        test posix kernel bridge
        test posix wait on many descriptors
        echo "[PASS] test_posix: TS-POSIX-001, TS-POSIX-002, TS-POSIX-003, TS-POSIX-004 and TS-POSIX-005 passed"
