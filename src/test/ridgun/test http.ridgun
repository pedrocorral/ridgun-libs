-- ============================================================
-- src/test/ridgun/test_http.ridgun
-- Automated test suite for http.ridgun (TS-HTTP-001)
-- @tests TS-HTTP-001
-- ============================================================

import test
import socket
import http

fn :: req method (String String String) => String
      req method (m, _, _)              =  m

fn :: req path (String String String) => String
      req path (_, p, _)              =  p

fn :: req body (String String String) => String
      req body (_, _, b)              =  b

fn :: resp code (Int String String) => Int
      resp code (c, _, _)           =  c

fn :: resp reason (Int String String) => String
      resp reason (_, r, _)           =  r

fn :: resp body (Int String String) => String
      resp body (_, _, b)           =  b

-- @tests TS-HTTP-001
fn :: test uri parsing => ()
      test uri parsing =
        u1 = "https://api.example.com:8443/v1/users?active=1&role=admin"
        uri scheme u1 -> assert str eq "https" "uri_scheme https"
        uri host u1 -> assert str eq "api.example.com" "uri_host"
        uri port u1 -> assert int equals 8443 "uri_port 8443"
        uri path u1 -> assert str eq "/v1/users" "uri_path"
        uri query u1 -> assert str eq "active=1&role=admin" "uri_query"
        u2 = "http://localhost/health"
        uri scheme u2 -> assert str eq "http" "uri_scheme http"
        uri host u2 -> assert str eq "localhost" "uri_host localhost"
        uri port u2 -> assert int equals 80 "default http port 80"
        uri path u2 -> assert str eq "/health" "uri_path /health"
        uri query u2 -> assert str eq "" "uri_query empty"
        ()

-- @tests TS-HTTP-001
fn :: test http11 request and response => ()
      test http11 request and response =
        hdrs    = [("Host", "api.example.com"), ("Authorization", "Bearer tok_xyz_987"), ("X-Injected", "safe\r\nEvil: 1")]
        raw_req = http build request "POST" "/v1/login" hdrs "{\"user\":\"alice\"}"
        parsed  = http parse request raw_req
        req method parsed -> assert str eq "POST" "req method POST"
        req path parsed -> assert str eq "/v1/login" "req path /v1/login"
        req body parsed -> assert str eq "{\"user\":\"alice\"}" "req body"
        phdrs   = http parse headers raw_req
        http header get phdrs "host" -> assert str eq "api.example.com" "case-insensitive host header"
        http header get phdrs "content-length" -> assert str eq "16" "auto Content-Length 16"
        http bearer token phdrs -> assert str eq "tok_xyz_987" "http_bearer_token"
        http header get phdrs "Evil" -> assert str eq "" "CRLF injection prevented"

        http status text 200 -> assert str eq "OK" "status 200 OK"
        http status text 404 -> assert str eq "Not Found" "status 404 Not Found"
        raw_resp = http build response 201 [("Content-Type", "application/json")] "{\"id\":42}"
        presp    = http parse response raw_resp
        rhdrs    = http parse headers raw_resp
        resp code presp -> assert int equals 201 "resp code 201"
        resp reason presp -> assert str eq "Created" "resp reason Created"
        http header get rhdrs "content-type" -> assert str eq "application/json" "resp Content-Type"
        resp body presp -> assert str eq "{\"id\":42}" "resp body"
        ()

-- @tests TS-HTTP-001
fn :: test http11 live tcp client and server => ()
      test http11 live tcp client and server =
        -- Spin up a real kernel TCP listener on port 0, connect a client, send HTTP request, respond, and read back
        l_res  = sys tcp listen "127.0.0.1" 0 8
        sock rc l_res -> assert int equals 0 "http server listen ok"
        lfd    = sock fd l_res
        port   = sys local port lfd
        port > 0 -> assert true "http server ephemeral port > 0"
        c_res  = sys tcp connect "localhost" port 500
        sock rc c_res -> assert int equals 0 "http client connect ok"
        cfd    = sock fd c_res
        a_res  = sys accept lfd 500
        sock accept rc a_res -> assert int equals 0 "http server accept ok"
        sfd    = sock accept fd a_res
        req_w  = http build request "GET" "/v1/ping?echo=1" [("Host", "localhost"), ("Connection", "close")] ""
        sock rc (sys send cfd req_w 500) -> assert int equals 0 "http client send request"
        srv_rx = sock recv data (sys recv sfd 4096 500)
        s_req  = http parse request srv_rx
        req method s_req -> assert str eq "GET" "server parsed GET"
        req path s_req -> assert str eq "/v1/ping?echo=1" "server parsed path"
        resp_w = http build response 200 [("Content-Type", "application/json"), ("Connection", "close")] "{\"pong\":true}"
        sock rc (sys send sfd resp_w 500) -> assert int equals 0 "http server send response"
        sys close sfd -> assert int equals 0 "http server close sfd"
        cli_rx = sock recv data (sys recv cfd 4096 500)
        c_resp = http parse response cli_rx
        c_hdrs = http parse headers cli_rx
        resp code c_resp -> assert int equals 200 "client parsed 200"
        http header get c_hdrs "content-type" -> assert str eq "application/json" "client parsed header"
        resp body c_resp -> assert str eq "{\"pong\":true}" "client parsed body"
        sys close cfd -> assert int equals 0 "http client close cfd"
        sys close lfd -> assert int equals 0 "http server close lfd"
        -- Verify http_get / http_post error handling on invalid scheme or refused port
        bad_g  = http get "ftp://localhost/file" 100
        http resp rc bad_g -> assert int equals (0 - 7) "http_get non-http scheme -> -7"
        ref_p  = http post "http://127.0.0.1:39998/api" "application/json" "{}" 100
        http resp rc ref_p -> assert int equals (0 - 3) "http_post refused port -> -3"
        -- Verify http_get against a real external background TCP responder over kernel loopback
        l_bg   = sys tcp listen "127.0.0.1" 0 8
        lfd_bg = sock fd l_bg
        p_bg   = sys local port lfd_bg
        sys close lfd_bg
        shell exec "python3 -c \"import socket; s=socket.socket(); s.setsockopt(socket.SOL_SOCKET,socket.SO_REUSEADDR,1); s.bind(('127.0.0.1',{p_bg})); s.listen(1); c,_=s.accept(); c.recv(1024); c.sendall(b'HTTP/1.1 200 OK\\r\\nContent-Type: text/plain\\r\\nContent-Length: 7\\r\\nConnection: close\\r\\n\\r\\nlive-ok'); c.close(); s.close()\" >/dev/null 2>&1 &"
        sys sleep ms 80
        g_live = http get "http://localhost:{p_bg}/status?check=1" 500
        http resp rc g_live -> assert int equals 0 "http_get live external TCP server rc == 0"
        http resp status g_live -> assert int equals 200 "http_get live status == 200"
        http header get (http resp headers g_live) "content-type" -> assert str eq "text/plain" "http_get live header"
        http resp body g_live -> assert str eq "live-ok" "http_get live body == live-ok"
        ()

fn :: main => ()
      main =
        test uri parsing
        test http11 request and response
        test http11 live tcp client and server
        echo "[PASS] test_http: TS-HTTP-001 passed"
