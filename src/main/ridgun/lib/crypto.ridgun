-- ============================================================
-- src/main/ridgun/lib/crypto.ridgun
-- Pure-Ridgun Cryptographic Primitives, Bitops, SHA-256, HMAC, PBKDF2,
-- Argon2id (RGF-015) & RFC 8439 ChaCha20-Poly1305 AEAD Library (CRYPTO)
-- @implements FR-CRYPTO-001
-- @implements FR-CRYPTO-002
-- @implements FR-CRYPTO-003
-- @implements FR-CRYPTO-004
-- @implements FR-CRYPTO-005
-- @implements FR-CRYPTO-006
-- @implements NFR-PERF-001
-- @implements API-CRYPTO-001
-- @implements DM-Argon2
-- @mitigates VUL-AUTHN-001
-- @mitigates VUL-INPUT-001
-- ============================================================

module :: crypto

import argon2id
-- The Argon2id API is part of this lib's contract (API-CRYPTO-001): whoever imports crypto gets it.
export argon2id

type CT16     = ct0: A, ct1: A, ct2: A, ct3: A, ct4: A, ct5: A, ct6: A, ct7: A, ct8: A, ct9: A, ct10: A, ct11: A, ct12: A, ct13: A, ct14: A, ct15: A
type CPbkCtx  = cptbl: CT16, cpipad: String, cpopad: String
type EcPoint  = ecx: Tensor[U64 * 260], ecy: Tensor[U64 * 260], ecz: Tensor[U64 * 260], ec_inf: Bool
-- Montgomery multiplication on 16-bit limbs as one repeated element-wise loop (ridgunc 1.0.39).
-- R = 2^(16 lim). The context holds what depends only on the modulus:
--   bm_minv = -m^-1 mod 2^16; bm_one = R mod m; bm_r2 = R^2 mod m;
--   bm_sh_(j) = j + 1 (the next limb), bm_nx the same but kept inside the lanes, bm_zr = 0 (limb 0 for every lane),
--   bm_e0 = 1 at lane 0 and 0 elsewhere.
type BnMont = bm_m: Tensor[U64 * 260], bm_lim: Int, bm_minv: Int, bm_one: Tensor[U64 * 260], bm_r2: Tensor[U64 * 260], bm_unit: Tensor[U64 * 260], bm_sh: Tensor[U64 * n], bm_nx: Tensor[U64 * n], bm_zr: Tensor[U64 * n], bm_e0: Tensor[U64 * n]
-- `ecm` is the Montgomery context of the field prime `ecp`; point coordinates are kept in Montgomery form (x R mod p).
type EcCurve  = ecp: Tensor[U64 * 260], ecn: Tensor[U64 * 260], ecb: Tensor[U64 * 260], ecgx: Tensor[U64 * 260], ecgy: Tensor[U64 * 260], eclimbs: Int, ecm: BnMont
type X509Cert = tbs_der: String, issuer_der: String, subject_der: String, issuer_cn: String, subject_cn: String, not_before_at: Int, not_after_at: Int, key_alg: String, pubkey_bytes: String, rsa_exp_bytes: String, sig_alg: String, sig_bytes: String, san_dns: [String], is_ca: Bool, key_usage_bits: Int, has_server_auth: Bool

-- ── RGF-019 Raw Byte Manipulation (`byte_str`, `bytes_from_list`, `bytes_to_list`) ──

fn :: norm byte mod Int => Int
      norm byte mod m   =
        | m < 0     = m + 256
        | otherwise = m

fn :: norm byte Int => Int
      norm byte b   =  norm byte mod (b % 256)

fn :: byte str norm Int => String
      byte str norm ub  =
        t     = Tensor[U8 * 1]
        t_(0) = ub and 255
        tensor to str t

-- @implements FR-CRYPTO-003
-- @implements API-CRYPTO-001
-- @mitigates VUL-INPUT-001
fn :: byte str Int => String
      byte str n   =
        byte str norm (norm byte n)

fn :: c sb append3 String String => String String String String
      c sb append3 n2     c3     =
        | (str len n2) < 65536 = ("", "", n2, c3)
        | otherwise            = ("", "", "", c3 + n2)

fn :: c sb append2 String String String => String String String String
      c sb append2 n1 c2 c3 =
        | (str len n1) < 8192 = ("", n1, c2, c3)
        | otherwise           = c sb append3 (c2 + n1) c3

fn :: c sb append1 String String String String => String String String String
      c sb append1 n0 c1 c2 c3 =
        | (str len n0) < 512 = (n0, c1, c2, c3)
        | otherwise          = c sb append2 (c1 + n0) c2 c3

fn :: c sb append String String String String String => String String String String
      c sb append chunk c0 c1 c2 c3 =
        c sb append1 (c0 + chunk) c1 c2 c3

fn :: c sb finish String String String String => String
      c sb finish c0 c1 c2 c3 = ((c3 + c2) + c1) + c0

-- The tensor is bound to a name: with `_` ridgunc 0.9.49 binds a wrong `n`.
fn :: c u8 len Tensor[U8]          => Int
      c u8 len (Tensor[U8 * n] bs) =  n

fn :: c copy loop Tensor[U8] Int Tensor[U8] Int Int Int => Int
      c copy loop dst doff src soff i n =
        | i >= n    = doff + n
        | otherwise =
          dst_(doff + i) = src_(soff + i)
          c copy loop dst doff src soff (i + 1) n

-- Copies `n` bytes of `src` from `soff` into `dst` at `doff`; returns `doff + n`.
fn :: c copy bytes Tensor[U8] Int Tensor[U8] Int Int => Int
      c copy bytes dst doff src soff n =  c copy loop dst doff src soff 0 n

-- Writes `w` as 4 little-endian bytes at `off`; returns `off + 4`.
fn :: c put le32 Tensor[U8] Int Int => Int
      c put le32 t          off w   =
        uw          = w and 0xFFFFFFFF
        t_(off)     = uw and 255
        t_(off + 1) = (uw shr 8) and 255
        t_(off + 2) = (uw shr 16) and 255
        t_(off + 3) = (uw shr 24) and 255
        off + 4

fn :: bytes from list loop Tensor[U8] [Int]    Int => Tensor[U8]
      bytes from list loop t          []       _   =  t
      bytes from list loop t          (b:rest) i   =
        t_(i) = b and 255
        bytes from list loop t rest (i + 1)

-- Values outside 0..255 are taken modulo 256 (`norm byte`).
-- @implements FR-CRYPTO-003
-- @implements API-CRYPTO-001
fn :: bytes from list [Int] => String
      bytes from list []    =  ""
      bytes from list bs    =
        n = c list len bs
        t = Tensor[U8 * n]
        tensor to str (bytes from list loop t bs 0)

-- @implements FR-CRYPTO-003
-- @implements API-CRYPTO-001
fn :: bytes to list String => [Int]
      bytes to list s      =
        tensor to list (tensor from str s)

-- ── RGF-019 32-Bit Unsigned Bitwise Operations (`band`, `bor`, `bxor`, `shl`, `shr`) ──

fn :: u32 mod Int => Int
      u32 mod m   =
        | m < 0     = m + 4294967296
        | otherwise = m

fn :: u32 val Int => Int
      u32 val x   =  x and 0xFFFFFFFF

fn :: byte band Int Int => Int
      byte band a   b   =
        (a and b) and 255

fn :: byte bor Int Int => Int
      byte bor a   b   =
        (a or b) and 255

fn :: byte bxor Int Int => Int
      byte bxor a   b   =
        (a xor b) and 255

-- @implements FR-CRYPTO-003
-- @implements API-CRYPTO-001
fn :: band Int Int => Int
      band a   b   =
        (a and b) and 0xFFFFFFFF

-- @implements FR-CRYPTO-003
-- @implements API-CRYPTO-001
fn :: bor Int Int => Int
      bor a   b   =
        (a or b) and 0xFFFFFFFF

fn :: c u32 bxor Int Int => Int
      c u32 bxor ua  ub  =
        (ua xor ub) and 0xFFFFFFFF

-- @implements FR-CRYPTO-003
-- @implements API-CRYPTO-001
fn :: bxor Int Int => Int
      bxor a   b   =
        (a xor b) and 0xFFFFFFFF

-- @implements FR-CRYPTO-003
-- @implements API-CRYPTO-001
-- @mitigates VUL-INPUT-001
fn :: shl Int Int => Int
      shl a   n   =
        | n < 0 or n >= 32 = 0
        | otherwise        = ((a and 0xFFFFFFFF) shl n) and 0xFFFFFFFF

-- @implements FR-CRYPTO-003
-- @implements API-CRYPTO-001
-- @mitigates VUL-INPUT-001
fn :: shr Int Int => Int
      shr a   n   =
        | n < 0 or n >= 32 = 0
        | otherwise        = (a and 0xFFFFFFFF) shr n

fn :: rotl32 Int Int => Int
      rotl32 x   n   =
        ux = x and 0xFFFFFFFF
        (((ux shl n) or (ux shr (32 - n))) and 0xFFFFFFFF)

-- ── Hex & List Utilities ─────────────────────────────────────

fn :: bytes list to hex Tensor[U8] => String
      bytes list to hex bs         =  bytes to hex bs

fn :: bytes to hex str String => String
      bytes to hex str raw    =
        bytes list to hex (tensor from str raw)

fn :: crypto hex val Int => Int
      crypto hex val c   =
        | c >= 48 and c <= 57  = c - 48
        | c >= 97 and c <= 102 = (c - 97) + 10
        | c >= 65 and c <= 70  = (c - 65) + 10
        | otherwise            = 0

fn :: hex str to bytes loop String Tensor[U8] Int Int => Tensor[U8]
      hex str to bytes loop h      out        i   n   =
        | i >= n    = out
        | otherwise =
          hi      = crypto hex val (str char at h (2 * i))
          lo      = crypto hex val (str char at h ((2 * i) + 1))
          out_(i) = (hi * 16) + lo
          hex str to bytes loop h out (i + 1) n

fn :: hex str to bytes String => Tensor[U8]
      hex str to bytes h      =
        n   = (str len h) / 2
        out = Tensor[U8 * n]
        hex str to bytes loop h out 0 n

fn :: hex to byte str String => String
      hex to byte str h      =
        tensor to str (hex str to bytes h)

fn :: c list len loop [Int] Int => Int
      c list len loop [] acc = acc
      c list len loop (_:rest) acc = c list len loop rest (acc + 1)

fn :: c list len [Int] => Int
      c list len xs    =  c list len loop xs 0

fn :: byte slice String Int   Int     => String
      byte slice s      start end_idx =
        slen = str len s
        st   =
          | start < 0 = 0
          | start > slen = slen
          | otherwise = start
        en   =
          | end_idx < st = st
          | end_idx > slen = slen
          | otherwise = end_idx
        n    = en - st
        out  = Tensor[U8 * n]
        c copy bytes out 0 (tensor from str s) st n
        tensor to str out

-- ── SHA-1 (FIPS 180-4 §6.1) ─────────────────────────────────
-- For protocols that require it (RFC 6455 WebSocket handshake, Git object ids).
-- SHA-1 is broken for collision resistance: never use it for signatures or certificates.

fn :: sha1 copy loop String Tensor[U8] Int Int => Tensor[U8]
      sha1 copy loop s      p          i   n   =
        | i >= n    = p
        | otherwise =
          p_(i) = str char at s i
          sha1 copy loop s p (i + 1) n

-- The message, the 0x80 byte, zeros, and the length in bits as a big-endian u64.
fn :: sha1 padded String => Tensor[U8]
      sha1 padded msg    =
        mlen = str len msg
        plen = (((mlen + 8) / 64) + 1) * 64
        p    = sha1 copy loop msg (Tensor[U8 * plen]) 0 mlen
        p_(mlen) = 128
        sha1 put len p (plen - 8) (mlen * 8) 0

fn :: sha1 put len Tensor[U8] Int Int  Int => Tensor[U8]
      sha1 put len p          off bits k   =
        | k >= 8    = p
        | otherwise =
          p_(off + k) = (bits shr (8 * (7 - k))) and 255
          sha1 put len p off bits (k + 1)

fn :: sha1 be32 at Tensor[U8] Int => Int
      sha1 be32 at p          off =  (p_(off) shl 24) or (p_(off + 1) shl 16) or (p_(off + 2) shl 8) or p_(off + 3)

fn :: sha1 load w Tensor[U8] Int Tensor[Int] Int => Tensor[Int]
      sha1 load w p          off w           t   =
        | t >= 16   = w
        | otherwise =
          w_(t) = sha1 be32 at p (off + (4 * t))
          sha1 load w p off w (t + 1)

fn :: sha1 expand w Tensor[Int] Int => Tensor[Int]
      sha1 expand w w           t   =
        | t >= 80   = w
        | otherwise =
          w_(t) = rotl32 (w_(t - 3) xor w_(t - 8) xor w_(t - 14) xor w_(t - 16)) 1
          sha1 expand w w (t + 1)

fn :: sha1 f Int Int Int Int => Int
      sha1 f t   b   c   d   =
        | t < 20    = (b and c) or ((b xor 0xFFFFFFFF) and d)
        | t < 40    = b xor c xor d
        | t < 60    = (b and c) or (b and d) or (c and d)
        | otherwise = b xor c xor d

fn :: sha1 k Int => Int
      sha1 k t   =
        | t < 20    = 0x5A827999
        | t < 40    = 0x6ED9EBA1
        | t < 60    = 0x8F1BBCDC
        | otherwise = 0xCA62C1D6

fn :: sha1 rounds Tensor[Int] Int Int Int Int Int Int => Int Int Int Int Int
      sha1 rounds w           t   a   b   c   d   e   =
        | t >= 80   = (a, b, c, d, e)
        | otherwise =
          tmp = ((rotl32 a 5) + (sha1 f t b c d) + e + (sha1 k t) + w_(t)) and 0xFFFFFFFF
          sha1 rounds w (t + 1) tmp a (rotl32 b 30) c d

fn :: sha1 add Tensor[Int] (Int Int Int Int Int) => Tensor[Int]
      sha1 add h           (a, b, c, d, e)      =
        h_(0) = (h_(0) + a) and 0xFFFFFFFF
        h_(1) = (h_(1) + b) and 0xFFFFFFFF
        h_(2) = (h_(2) + c) and 0xFFFFFFFF
        h_(3) = (h_(3) + d) and 0xFFFFFFFF
        h_(4) = (h_(4) + e) and 0xFFFFFFFF
        h

fn :: sha1 blocks Tensor[U8] Tensor[Int] Tensor[Int] Int Int  => Tensor[Int]
      sha1 blocks p          h           w           off total =
        | off >= total = h
        | otherwise    =
          w80 = sha1 expand w (sha1 load w p off w 0) 16
          h2  = sha1 add h (sha1 rounds w80 0 h_(0) h_(1) h_(2) h_(3) h_(4))
          sha1 blocks p h2 w (off + 64) total

fn :: sha1 out Tensor[Int] Tensor[U8] Int => Tensor[U8]
      sha1 out h           out        i   =
        | i >= 20   = out
        | otherwise =
          out_(i) = (h_(i / 4) shr (8 * (3 - (i % 4)))) and 255
          sha1 out h out (i + 1)

-- @implements FR-CRYPTO-003
-- @implements API-CRYPTO-001
-- The 20-byte SHA-1 digest of `msg`, as a raw byte string.
fn :: sha1 bytes String => String
      sha1 bytes msg    =
        p = sha1 padded msg
        h = Tensor[Int * 5]
        h_(0) = 0x67452301
        h_(1) = 0xEFCDAB89
        h_(2) = 0x98BADCFE
        h_(3) = 0x10325476
        h_(4) = 0xC3D2E1F0
        hf = sha1 blocks p h (Tensor[Int * 80]) 0 ((((str len msg) + 8) / 64 + 1) * 64)
        tensor to str (sha1 out hf (Tensor[U8 * 20]) 0)

-- @implements FR-CRYPTO-003
-- @implements API-CRYPTO-001
-- The SHA-1 digest of `msg` as 40 lowercase hex characters.
fn :: sha1 hex String => String
      sha1 hex msg    =  bytes to hex str (sha1 bytes msg)

-- ── RFC 1321 MD5 (`md5 bytes`, `md5 hex`) ───────────────────
-- MD5 is broken as a hash. It is here only for protocols that still name it (PostgreSQL md5 passwords).

fn :: md5 k => Tensor[Int]
      md5 k =  tensor from list [3614090360, 3905402710, 606105819, 3250441966, 4118548399, 1200080426, 2821735955, 4249261313, 1770035416, 2336552879, 4294925233, 2304563134, 1804603682, 4254626195, 2792965006, 1236535329, 4129170786, 3225465664, 643717713, 3921069994, 3593408605, 38016083, 3634488961, 3889429448, 568446438, 3275163606, 4107603335, 1163531501, 2850285829, 4243563512, 1735328473, 2368359562, 4294588738, 2272392833, 1839030562, 4259657740, 2763975236, 1272893353, 4139469664, 3200236656, 681279174, 3936430074, 3572445317, 76029189, 3654602809, 3873151461, 530742520, 3299628645, 4096336452, 1126891415, 2878612391, 4237533241, 1700485571, 2399980690, 4293915773, 2240044497, 1873313359, 4264355552, 2734768916, 1309151649, 4149444226, 3174756917, 718787259, 3951481745]

fn :: md5 s => Tensor[Int]
      md5 s =  tensor from list [7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22, 5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20, 4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23, 6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21]

-- The message, the 0x80 byte, zeros, and the length in bits as a little-endian u64.
fn :: md5 padded String => Tensor[U8]
      md5 padded msg    =
        mlen = str len msg
        plen = (((mlen + 8) / 64) + 1) * 64
        p    = sha1 copy loop msg (Tensor[U8 * plen]) 0 mlen
        p_(mlen) = 128
        md5 put len p (plen - 8) (mlen * 8) 0

fn :: md5 put len Tensor[U8] Int Int Int => Tensor[U8]
      md5 put len p off bits k =
        | k >= 8    = p
        | otherwise =
          p_(off + k) = (bits shr (8 * k)) and 255
          md5 put len p off bits (k + 1)

fn :: md5 load w Tensor[U8] Int Tensor[Int] Int => Tensor[Int]
      md5 load w p off w t =
        | t >= 16   = w
        | otherwise =
          w_(t) = p_(off + (4 * t)) or (p_(off + (4 * t) + 1) shl 8) or (p_(off + (4 * t) + 2) shl 16) or (p_(off + (4 * t) + 3) shl 24)
          md5 load w p off w (t + 1)

fn :: md5 f Int Int Int Int => Int
      md5 f i b c d =
        | i < 16    = (b and c) or ((b xor 0xFFFFFFFF) and d)
        | i < 32    = (d and b) or ((d xor 0xFFFFFFFF) and c)
        | i < 48    = b xor c xor d
        | otherwise = c xor (b or (d xor 0xFFFFFFFF))

-- Which message word step i uses.
fn :: md5 g Int => Int
      md5 g i =
        | i < 16    = i
        | i < 32    = ((5 * i) + 1) and 15
        | i < 48    = ((3 * i) + 5) and 15
        | otherwise = (7 * i) and 15

fn :: md5 rounds Tensor[Int] Tensor[Int] Tensor[Int] Int Int Int Int Int => Int Int Int Int
      md5 rounds w k s i a b c d =
        | i >= 64   = (a, b, c, d)
        | otherwise =
          f = ((md5 f i b c d) + a + k_(i) + w_(md5 g i)) and 0xFFFFFFFF
          md5 rounds w k s (i + 1) d ((b + (rotl32 f s_(i))) and 0xFFFFFFFF) b c

fn :: md5 add Tensor[Int] (Int Int Int Int) => Tensor[Int]
      md5 add h (a, b, c, d) =
        h_(0) = (h_(0) + a) and 0xFFFFFFFF
        h_(1) = (h_(1) + b) and 0xFFFFFFFF
        h_(2) = (h_(2) + c) and 0xFFFFFFFF
        h_(3) = (h_(3) + d) and 0xFFFFFFFF
        h

fn :: md5 blocks Tensor[U8] Tensor[Int] Tensor[Int] Tensor[Int] Tensor[Int] Int Int => Tensor[Int]
      md5 blocks p h w k s off total =
        | off >= total = h
        | otherwise    =
          w16 = md5 load w p off w 0
          h2  = md5 add h (md5 rounds w16 k s 0 h_(0) h_(1) h_(2) h_(3))
          md5 blocks p h2 w k s (off + 64) total

fn :: md5 out Tensor[Int] Tensor[U8] Int => Tensor[U8]
      md5 out h out i =
        | i >= 16   = out
        | otherwise =
          out_(i) = (h_(i / 4) shr (8 * (i % 4))) and 255
          md5 out h out (i + 1)

-- @implements FR-CRYPTO-003
-- @implements API-CRYPTO-001
-- The 16-byte MD5 digest of `msg`, as a raw byte string.
fn :: md5 bytes String => String
      md5 bytes msg    =
        p = md5 padded msg
        h = Tensor[Int * 4]
        h_(0) = 0x67452301
        h_(1) = 0xEFCDAB89
        h_(2) = 0x98BADCFE
        h_(3) = 0x10325476
        hf = md5 blocks p h (Tensor[Int * 16]) (md5 k) (md5 s) 0 ((((str len msg) + 8) / 64 + 1) * 64)
        tensor to str (md5 out hf (Tensor[U8 * 16]) 0)

-- @implements FR-CRYPTO-003
-- @implements API-CRYPTO-001
-- The MD5 digest of `msg` as 32 lowercase hex characters.
fn :: md5 hex String => String
      md5 hex msg    =  bytes to hex str (md5 bytes msg)

-- ── RGF-015 SHA-256, HMAC-SHA-256, `ct_equal`, PBKDF2-HMAC-SHA-256 ──

-- @implements FR-CRYPTO-003
-- @implements API-CRYPTO-001
fn :: sha256 hex String => String
      sha256 hex data   =
        sha256 str data

-- @implements FR-CRYPTO-003
-- @implements API-CRYPTO-001
fn :: sha256 bytes String => String
      sha256 bytes data   =
        sha256 raw data

fn :: bitxor key pad loop Tensor[U8] Tensor[U8] Int Int Int => Tensor[U8]
      bitxor key pad loop kb         out        pad i   n   =
        | i >= n    = out
        | otherwise =
          out_(i) = (kb_(i) xor pad) and 255
          bitxor key pad loop kb out pad (i + 1) n

fn :: bitxor key pad Tensor[U8] Int => Tensor[U8]
      bitxor key pad kb         pad =
        n   = c u8 len kb
        out = Tensor[U8 * n]
        bitxor key pad loop kb out pad 0 n

-- The HMAC key `raw` zero-padded to `blen` bytes (`raw` is at most `blen` bytes).
fn :: c hmac key block String Int  => Tensor[U8]
      c hmac key block raw    blen =
        k   = tensor from str raw
        out = Tensor[U8 * blen]
        c copy bytes out 0 k 0 (c u8 len k)
        out

fn :: normalize hmac key String => Tensor[U8]
      normalize hmac key key    =
        | (str len key) > 64 = c hmac key block (sha256 bytes key) 64
        | otherwise          = c hmac key block key 64

-- @implements FR-CRYPTO-003
-- @implements API-CRYPTO-001
fn :: hmac sha256 String String => String
      hmac sha256 key    msg    =
        k_block = normalize hmac key key
        ipad_s  = tensor to str (bitxor key pad k_block 54)
        opad_s  = tensor to str (bitxor key pad k_block 92)
        inner   = sha256 raw (ipad_s + msg)
        sha256 raw (opad_s + inner)

fn :: ct diff str String String Int Int Int => Int
      ct diff str a b idx slen acc =
        | idx >= slen = acc
        | otherwise   =
          ca = norm byte (str char at a idx)
          cb = norm byte (str char at b idx)
          ct diff str a b (idx + 1) slen (acc + (byte bxor ca cb))

-- @implements FR-CRYPTO-003
-- @implements API-CRYPTO-001
-- @mitigates VUL-AUTHN-001
fn :: ct equal String String => Bool
      ct equal a      b      =
        | (str len a) != (str len b) = False
        | otherwise                  = (ct diff str a b 0 (str len a) 0) == 0

fn :: bitxor byte lists loop Tensor[U8] Tensor[U8] Tensor[U8] Int Int => Tensor[U8]
      bitxor byte lists loop a          b          out        i   n   =
        | i >= n    = out
        | otherwise =
          out_(i) = byte bxor a_(i) b_(i)
          bitxor byte lists loop a b out (i + 1) n

-- Byte-wise XOR over the shorter of the two lengths.
fn :: bitxor byte lists Tensor[U8] Tensor[U8] => Tensor[U8]
      bitxor byte lists a          b          =
        la  = c u8 len a
        lb  = c u8 len b
        n   =
          | la < lb   = la
          | otherwise = lb
        out = Tensor[U8 * n]
        bitxor byte lists loop a b out 0 n

fn :: bitxor byte strings String String => String
      bitxor byte strings a      b      =
        tensor to str (bitxor byte lists (tensor from str a) (tensor from str b))

fn :: be32 bytes Int => String
      be32 bytes n   =
        un    = u32 val n
        t     = Tensor[U8 * 4]
        t_(0) = (un shr 24) and 255
        t_(1) = (un shr 16) and 255
        t_(2) = (un shr 8) and 255
        t_(3) = un and 255
        tensor to str t

fn :: c get16 CT16 Int => A
      c get16 row  idx =
        | idx < 8 =
          | idx < 4 =
            | idx < 2 =
              | idx == 0  = ct0 row
              | otherwise = ct1 row |.
            | otherwise =
              | idx == 2  = ct2 row
              | otherwise = ct3 row |. |.
          | otherwise =
            | idx < 6 =
              | idx == 4  = ct4 row
              | otherwise = ct5 row |.
            | otherwise =
              | idx == 6  = ct6 row
              | otherwise = ct7 row |. |.
        | otherwise =
          | idx < 12 =
            | idx < 10 =
              | idx == 8  = ct8 row
              | otherwise = ct9 row |.
            | otherwise =
              | idx == 10 = ct10 row
              | otherwise = ct11 row |. |.
          | otherwise =
            | idx < 14 =
              | idx == 12 = ct12 row
              | otherwise = ct13 row |.
            | otherwise =
              | idx == 14 = ct14 row
              | otherwise = ct15 row

fn :: c set16 CT16 Int A   => CT16
      c set16 m    idx val =
        | idx < 8 =
          | idx < 4 =
            | idx < 2 =
              | idx == 0  = m with ct0 = val
              | otherwise = m with ct1 = val |.
            | otherwise =
              | idx == 2  = m with ct2 = val
              | otherwise = m with ct3 = val |. |.
          | otherwise =
            | idx < 6 =
              | idx == 4  = m with ct4 = val
              | otherwise = m with ct5 = val |.
            | otherwise =
              | idx == 6  = m with ct6 = val
              | otherwise = m with ct7 = val |. |.
        | otherwise =
          | idx < 12 =
            | idx < 10 =
              | idx == 8  = m with ct8 = val
              | otherwise = m with ct9 = val |.
            | otherwise =
              | idx == 10 = m with ct10 = val
              | otherwise = m with ct11 = val |. |.
          | otherwise =
            | idx < 14 =
              | idx == 12 = m with ct12 = val
              | otherwise = m with ct13 = val |.
            | otherwise =
              | idx == 14 = m with ct14 = val
              | otherwise = m with ct15 = val

fn :: c build b16 Int  => CT16
      c build b16 base =
