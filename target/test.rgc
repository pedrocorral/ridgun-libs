-- Pure-Ridgun Unit Test Assertion Library

fn :: fail test String => ()
      fail test msg    =
        _ = echo "[ASSERT FAIL] {msg}"
        sys_exit 1

fn :: assert true msg Bool String => ()
      assert true msg cond label  =
        | cond      = ()
        | otherwise = fail test "expected True at {label}"

fn :: assert true Bool => ()
      assert true cond =  assert true msg cond "assert_true"

fn :: assert equals A      A        => ()
      assert equals actual expected =
        | actual == expected = ()
        | otherwise          = fail test "assert_equals failed"
