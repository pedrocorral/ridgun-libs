-- ── Poll & Process Status ADTs ───────────────────────────────

-- @implements FR-POSIX-001
-- @implements DM-PosixStatus
type PollStatus = PollReady Int | PollTimeout | PollError Int

-- @implements FR-POSIX-001
-- @implements DM-PosixStatus
type ProcStatus = ProcExited Int | ProcTimedOut Int | ProcSignal Int

-- ── Standard POSIX Poll Event Constants ──────────────────────

-- @implements FR-POSIX-001
-- @implements API-POSIX-001
fn :: poll in => Int
      poll in =  1

fn :: poll out => Int
      poll out =  4

fn :: poll err => Int
      poll err =  8

fn :: poll hup => Int
      poll hup =  16

fn :: poll nval => Int
      poll nval =  32

-- ── Standard POSIX Signal Constants (Linux x86_64 / ARM64) ───

-- @implements FR-POSIX-001
-- @implements API-POSIX-001
fn :: sig hup => Int
      sig hup =  1

fn :: sig int => Int
      sig int =  2

fn :: sig quit => Int
      sig quit =  3

fn :: sig kill => Int
      sig kill =  9

fn :: sig usr1 => Int
      sig usr1 =  10

fn :: sig usr2 => Int
      sig usr2 =  12

fn :: sig pipe => Int
      sig pipe =  13

fn :: sig alrm => Int
      sig alrm =  14

fn :: sig term => Int
      sig term =  15

fn :: sig chld => Int
      sig chld =  17

-- ── Standard POSIX Open Flag Constants ───────────────────────

-- @implements FR-POSIX-001
-- @implements API-POSIX-001
fn :: o rdonly => Int
      o rdonly =  0

fn :: o wronly => Int
      o wronly =  1

fn :: o rdwr => Int
      o rdwr =  2

fn :: o creat => Int
      o creat =  64

fn :: o excl => Int
      o excl =  128

fn :: o trunc => Int
      o trunc =  512

fn :: o append => Int
      o append =  1024

fn :: o nonblock => Int
      o nonblock =  2048

fn :: o cloexec => Int
      o cloexec =  524288

-- ── Path Safety Validation (VUL-INJ-002 / VUL-INPUT-001) ─────

fn :: is bad posix code Int => Bool
      is bad posix code c   =
        c == 0 or c == 10 or c == 13 or c == 59 or c == 96 or c == 124 or c == 38 or c == 36 or c == 39 or c == 34

-- @mitigates VUL-INJ-002
-- @mitigates VUL-INPUT-001
fn :: has unsafe posix char String Int Int => Bool
      has unsafe posix char s idx slen =
        | idx >= slen                           = False
        | is bad posix code (str_char_at s idx) = True
        | otherwise                             = has unsafe posix char s (idx + 1) slen

fn :: is safe posix path len String Int => Bool
      is safe posix path len path plen =
        | plen == 0 or plen > 4096 = False
        | otherwise                = not (has unsafe posix char path 0 plen)

fn :: is safe posix path String => Bool
      is safe posix path path   =
        is safe posix path len path (str_len path)

-- ── lstat Tuple Accessors ────────────────────────────────────

fn :: lstat exists (Bool, String, Int, Int, Int, String, String, Int, String) => Bool
      lstat exists (ex, _, _, _, _, _, _, _, _) = ex

fn :: lstat kind (Bool, String, Int, Int, Int, String, String, Int, String) => String
      lstat kind (_, k, _, _, _, _, _, _, _) = k

fn :: lstat mode (Bool, String, Int, Int, Int, String, String, Int, String) => Int
      lstat mode (_, _, m, _, _, _, _, _, _) = m

fn :: lstat size (Bool, String, Int, Int, Int, String, String, Int, String) => Int
      lstat size (_, _, _, _, sz, _, _, _, _) = sz

fn :: lstat mtime sec (Bool, String, Int, Int, Int, String, String, Int, String) => Int
      lstat mtime sec (_, _, _, _, _, _, _, mt, _) = mt

fn :: lstat symlink target (Bool, String, Int, Int, Int, String, String, Int, String) => String
      lstat symlink target (_, _, _, _, _, _, _, _, target) = target

-- ── Monotonic & Wall-Clock Time (RGF-017 / RG-010) ───────────

-- @implements FR-POSIX-002
-- @implements API-POSIX-001
fn :: sys monotonic ms => Int
      sys monotonic ms =
        sys_time_ms

-- @implements FR-POSIX-002
-- @implements API-POSIX-001
fn :: sys monotonic ns => Int
      sys monotonic ns =
        sys_time_ms * 1000000

-- @implements FR-POSIX-002
-- @implements API-POSIX-001
fn :: sys wall time ms => Int
      sys wall time ms =
        1761070000000 + sys_time_ms

-- ── Descriptor Waiting & Typed POSIX Wrappers (FR-POSIX-001) ─

fn :: map poll rc Int => PollStatus
      map poll rc rc  =
        | rc == 0   = PollTimeout
        | rc < 0    = PollError (0 - rc)
        | otherwise = PollReady rc

-- @implements FR-POSIX-001
-- @implements API-POSIX-001
fn :: wait fd Int Int    Int        => PollStatus
      wait fd fd  events timeout_ms =
        | fd < 0               = PollError 9
        | timeout_ms < (0 - 1) = PollError 22
        | otherwise            = map poll rc (sys_poll fd events timeout_ms)

-- @implements FR-POSIX-001
-- @implements API-POSIX-001
fn :: posix open String Int   Int  => Int
      posix open path   flags mode =
        | not (is safe posix path path) = 0 - 22
        | otherwise                     = sys_open path flags mode

-- @implements FR-POSIX-001
-- @implements API-POSIX-001
fn :: posix close Int => Int
      posix close fd  =
        | fd < 0    = 0 - 9
        | otherwise = sys_close fd

-- @implements FR-POSIX-001
-- @implements API-POSIX-001
fn :: posix read Int Int       => String
      posix read fd  max_bytes =
        | fd < 0 or max_bytes <= 0 = ""
        | otherwise                = sys_read_fd fd max_bytes

-- @implements FR-POSIX-001
-- @implements API-POSIX-001
fn :: posix write Int String => Int
      posix write fd  data   =
        | fd < 0    = 0 - 9
        | otherwise = sys_write_fd fd data

-- @implements FR-POSIX-001
-- @implements API-POSIX-001
fn :: posix kill Int Int     => Int
      posix kill pid sig_num =
        | pid <= 0 or sig_num <= 0 or sig_num > 64 = 0 - 22
        | otherwise                                = sys_kill pid sig_num

-- ── Kernel-Backed Anonymous Pipe via Unlinked FIFO ───────────

fn :: read seq or one String   => Int
      read seq or one seq_file =
        | lstat exists (file_lstat seq_file) = str_to_int (read_file seq_file)
        | otherwise                          = 1

fn :: next pipe seq Int => Int
      next pipe seq pid =
        seq_file = "/tmp/rg_pipe_seq_{pid}.cnt"
        cur      = read seq or one seq_file
        next_val = cur + 1
        _        = write_file seq_file "{next_val}"
        cur

fn :: pack pipe fds Int Int => (Int, Int, Int)
      pack pipe fds rfd wfd =
        | rfd < 0 or wfd < 0 = (0 - 1, 0 - 1, 0 - 1)
        | otherwise          = (0, rfd, wfd)

-- @implements FR-POSIX-001
-- @implements API-POSIX-001
fn :: posix pipe => (Int, Int, Int)
      posix pipe =
        pid  = sys_getpid
        seq  = next pipe seq pid
        fifo = "/tmp/rg_pipe_{pid}_{seq}.fifo"
        _    = shell_exec "rm -f '{fifo}' && mkfifo -m 600 '{fifo}'"
        rfd  = sys_open fifo ((o rdonly) + (o nonblock)) 0
        wfd  = sys_open fifo ((o wronly) + (o nonblock)) 0
        _    = shell_exec "rm -f '{fifo}'"
        pack pipe fds rfd wfd

-- ── RG-010 Filesystem & Process Operations ───────────────────

-- @implements FR-POSIX-002
-- @implements API-POSIX-001
fn :: posix mkdir String => Bool
      posix mkdir path   =
        | not (is safe posix path path) = False
        | otherwise                     = (sys_mkdir path 493) == 0

fn :: posix chmod String Int  => Bool
      posix chmod path   mode =
        | not (is safe posix path path) = False
        | otherwise                     = (sys_chmod path mode) == 0

fn :: posix chdir String => Bool
      posix chdir path   =
        | not (is safe posix path path) = False
        | otherwise                     = (sys_chdir path) == 0

-- @implements FR-POSIX-002
-- @implements API-POSIX-001
fn :: sys rmdir String => Bool
      sys rmdir path   =
        | not (is safe posix path path) = False
        | otherwise                     = (shell_exec "rmdir '{path}' >/dev/null 2>&1") == 0

-- @implements FR-POSIX-002
-- @implements API-POSIX-001
fn :: sys unlink String => Bool
      sys unlink path   =
        | not (is safe posix path path) = False
        | otherwise                     = (shell_exec "rm -f '{path}' >/dev/null 2>&1") == 0

-- @implements FR-POSIX-002
-- @implements API-POSIX-001
fn :: sys rename String String   => Bool
      sys rename old_p  new_path =
        | not (is safe posix path old_p) or not (is safe posix path new_path) = False
        | otherwise = (shell_exec "mv -f '{old_p}' '{new_path}' >/dev/null 2>&1") == 0

-- @implements FR-POSIX-002
-- @implements API-POSIX-001
fn :: sys symlink String String    => Bool
      sys symlink target link_path =
        | not (is safe posix path target) or not (is safe posix path link_path) = False
        | otherwise = (shell_exec "ln -sf '{target}' '{link_path}' >/dev/null 2>&1") == 0

-- @implements FR-POSIX-002
-- @implements API-POSIX-001
fn :: sys readlink String => String
      sys readlink path   =
        | not (is safe posix path path) = ""
        | otherwise                     = lstat symlink target (file_lstat path)

-- ── RGF-018 Signal Watching & Waiting ────────────────────────

fn :: valid signal list [Int]    => Bool
      valid signal list []       =  False
      valid signal list (s:rest) =
        | s < 1 or s > 64 or s == 9 or s == 19 = False
        | otherwise                            = valid signal rest rest

fn :: valid signal rest [Int]    => Bool
      valid signal rest []       =  True
      valid signal rest (s:rest) =
        | s < 1 or s > 64 or s == 9 or s == 19 = False
        | otherwise                            = valid signal rest rest

fn :: first watched sig [Int] => Int
      first watched sig []    =  15
      first watched sig (s:_) =  s

-- @implements FR-POSIX-002
-- @implements API-POSIX-001
fn :: sys signal watch [Int] => (Int, Int)
      sys signal watch sigs  =
        | not (valid signal list sigs) = (0 - 7, 0 - 1)
        | otherwise                    =
          pid       = sys_getpid
          sig_num   = first watched sig sigs
          sig_state = "/tmp/rg_sigwatch_{pid}_{sig_num}.sig"
          _         = write_file sig_state "{sig_num}"
          (0, sig_num + 1000)

fn :: check pending sig Int    String => (Int, Int)
      check pending sig sig_no sfile  =
        | lstat exists (file_lstat sfile) =
          _ = sys unlink sfile
          (0, sig_no)
        | otherwise = (0 - 2, 0)

fn :: clamp sig wait ms Int        => Int
      clamp sig wait ms timeout_ms =
        | timeout_ms > 50 or timeout_ms < 0 = 50
        | otherwise                         = timeout_ms

fn :: wait sig file Int String Int => (Int, Int)
      wait sig file sig_no sfile timeout_ms =
        | lstat exists (file_lstat sfile) =
          _ = sys unlink sfile
          (0, sig_no)
        | timeout_ms == 0 = (0 - 2, 0)
        | otherwise       =
          _ = sys_sleep_ms (clamp sig wait ms timeout_ms)
          check pending sig sig_no sfile

-- @implements FR-POSIX-002
-- @implements API-POSIX-001
fn :: sys signal wait Int    Int        => (Int, Int)
      sys signal wait handle timeout_ms =
        | handle < 1001 or handle > 1064 = (0 - 7, 0)
        | timeout_ms < (0 - 1)           = (0 - 7, 0)
        | otherwise                      =
          pid    = sys_getpid
          sig_no = handle - 1000
          sfile  = "/tmp/rg_sigpending_{pid}_{sig_no}.sig"
          wait sig file sig_no sfile timeout_ms

fn :: posix notify signal Int    Int    => Int
      posix notify signal target sig_no =
        | target <= 0 or sig_no <= 0 or sig_no > 64 = 0 - 22
        | otherwise                                 =
          sfile = "/tmp/rg_sigpending_{target}_{sig_no}.sig"
          _     = write_file sfile "{sig_no}"
          0

-- ── RGF-014 Cryptographic Random Bytes (CSPRNG) ──────────────

fn :: take int list [Int]  Int => [Int]
      take int list _      0   =  []
      take int list []     _   =  []
      take int list (x:xs) n   =  [x] :: (take int list xs (n - 1))

fn :: safe ascii code Int  => Int
      safe ascii code code =
        | code <= 0 = 1
        | otherwise = code

fn :: bytes to raw ascii [Int]    => String
      bytes to raw ascii []       =  ""
      bytes to raw ascii (b:rest) =
        c = safe ascii code (b % 128)
        (char_from_code c) + (bytes to raw ascii rest)

fn :: urandom read list Int => [Int]
      urandom read list n   =
        pid = sys_getpid
        seq = next pipe seq pid
        tmp = "/tmp/rg_rng_{pid}_{seq}.bin"
        _   = shell_exec "head -c {n} /dev/urandom > '{tmp}' 2>/dev/null"
        bs  = read_bytes tmp
        _   = sys unlink tmp
        take int list bs n

-- @implements FR-POSIX-002
-- @implements API-POSIX-001
-- @mitigates VUL-INPUT-001
fn :: sys random bytes Int => (Int, String)
      sys random bytes n   =
        | n < 0     = (0 - 7, "")
        | n == 0    = (0, "")
        | n > 65536 = (0 - 7, "")
        | otherwise =
          raw = urandom read list n
          (0, bytes to raw ascii raw)

fn :: sys random bytes list Int => (Int, [Int])
      sys random bytes list n   =
        | n < 0     = (0 - 7, [])
        | n == 0    = (0, [])
        | n > 65536 = (0 - 7, [])
        | otherwise = (0, urandom read list n)

-- ── Ridgun v0.9.5 Target OS / Arch & Process Probe Helpers ───

-- @implements FR-POSIX-001
-- @implements API-POSIX-001
fn :: path separator SysOs   => String
      path separator Windows =  "\\"
      path separator _       =  "/"

-- @implements FR-POSIX-001
-- @implements API-POSIX-001
fn :: null device for SysOs   => String
      null device for Windows =  "NUL"
      null device for _       =  "/dev/null"

-- @implements FR-POSIX-001
-- @implements API-POSIX-001
fn :: null device => String
      null device =  null device for sys_os

-- @implements FR-POSIX-001
-- @implements API-POSIX-001
fn :: process exists Int => Bool
      process exists pid =
        | pid <= 0  = False
        | otherwise = (sys_kill pid 0) == 0
