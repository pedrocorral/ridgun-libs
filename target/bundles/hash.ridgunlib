-- ============================================================
-- src/main/ridgun/lib/hash.ridgun
-- Keyed hash for hash tables: SipHash-1-3 (Aumasson & Bernstein), 128-bit key, 64-bit result
-- @implements FR-HASH-001
-- @implements API-HASH-001
-- @mitigates VUL-INPUT-001
-- ============================================================
-- A 64-bit word is kept as two halves of 32 bits, because an Int holds 63 bits in place and a value
-- that needs all 64 is stored apart. The low 32 bits of the result never leave a plain Int.
-- SPEED: this is the reference in plain Ridgun: about 2 µs for a 25-byte key (some 600 bit operations).
-- It defines the result; a native `siphash13 range` was asked of the compiler on 2026-11-19 (see
-- docs/requirements/functional/hash/FR-HASH-001). Until it exists, do not put this on a hot path.

module :: hash

import posix

-- The byte at `i` as 0..255.
fn :: hs byte String Int => Int
      hs byte s i =  (str char at s i) and 255

-- The byte at `i`, or 0 at or after `to`.
fn :: hs tail String Int Int => Int
      hs tail s i to =
        | i >= to   = 0
        | otherwise = (str char at s i) and 255

fn :: hs pick Int Int Int => Int
      hs pick want hi lo =
        | want == 0 = lo
        | otherwise = (hi shl 32) or lo

-- Little-endian 32-bit word of the key at `off`.
fn :: hs key word String Int => Int
      hs key word k off =  (hs byte k off) or ((hs byte k (off + 1)) shl 8) or ((hs byte k (off + 2)) shl 16) or ((hs byte k (off + 3)) shl 24)

-- One message word per turn: v3 ^= m, 1 round(s), v0 ^= m. The 8 state values are the halves of v0..v3.
fn :: siphash13 loop String Int Int Int Int Int Int Int Int Int Int Int Int Int => Int
      siphash13 loop s off full to n want a0 b0 a1 b1 a2 b2 a3 b3 =
        | off >= full = siphash13 last s off to n want a0 b0 a1 b1 a2 b2 a3 b3
        | otherwise   =
          t1 = (hs byte s off) or ((hs byte s (off + 1)) shl 8) or ((hs byte s (off + 2)) shl 16) or ((hs byte s (off + 3)) shl 24)
          t2 = (hs byte s (off + 4)) or ((hs byte s (off + 5)) shl 8) or ((hs byte s (off + 6)) shl 16) or ((hs byte s (off + 7)) shl 24)
          t3 = a3 xor t2
          t4 = b3 xor t1
          t5 = b0 + b1
          t6 = ((a0 + a1) + (t5 shr 32)) and 0xFFFFFFFF
          t7 = t5 and 0xFFFFFFFF
          t8 = ((a1 shl 13) or (b1 shr 19)) and 0xFFFFFFFF
          t9 = ((b1 shl 13) or (a1 shr 19)) and 0xFFFFFFFF
          t10 = t8 xor t6
          t11 = t9 xor t7
          t12 = b2 + t4
          t13 = ((a2 + t3) + (t12 shr 32)) and 0xFFFFFFFF
          t14 = t12 and 0xFFFFFFFF
          t15 = ((t3 shl 16) or (t4 shr 16)) and 0xFFFFFFFF
          t16 = ((t4 shl 16) or (t3 shr 16)) and 0xFFFFFFFF
          t17 = t15 xor t13
          t18 = t16 xor t14
          t19 = t6 + t18
          t20 = ((t7 + t17) + (t19 shr 32)) and 0xFFFFFFFF
          t21 = t19 and 0xFFFFFFFF
          t22 = ((t17 shl 21) or (t18 shr 11)) and 0xFFFFFFFF
          t23 = ((t18 shl 21) or (t17 shr 11)) and 0xFFFFFFFF
          t24 = t22 xor t20
          t25 = t23 xor t21
          t26 = t14 + t11
          t27 = ((t13 + t10) + (t26 shr 32)) and 0xFFFFFFFF
          t28 = t26 and 0xFFFFFFFF
          t29 = ((t10 shl 17) or (t11 shr 15)) and 0xFFFFFFFF
          t30 = ((t11 shl 17) or (t10 shr 15)) and 0xFFFFFFFF
          t31 = t29 xor t27
          t32 = t30 xor t28
          t33 = t20 xor t2
          t34 = t21 xor t1
          siphash13 loop s (off + 8) full to n want t33 t34 t31 t32 t28 t27 t24 t25

-- The last word: the 0..7 bytes left and the length in its top byte; then v2 ^= 0xff and 3 rounds.
-- `want` 0 gives the low 32 bits (always a small Int), anything else the 64 bits.
fn :: siphash13 last String Int Int Int Int Int Int Int Int Int Int Int Int => Int
      siphash13 last s off to n want a0 b0 a1 b1 a2 b2 a3 b3 =
        t1 = (hs tail s off to) or ((hs tail s (off + 1) to) shl 8) or ((hs tail s (off + 2) to) shl 16) or ((hs tail s (off + 3) to) shl 24)
        t2 = (hs tail s (off + 4) to) or ((hs tail s (off + 5) to) shl 8) or ((hs tail s (off + 6) to) shl 16) or ((n and 255) shl 24)
        t3 = a3 xor t2
        t4 = b3 xor t1
        t5 = b0 + b1
        t6 = ((a0 + a1) + (t5 shr 32)) and 0xFFFFFFFF
        t7 = t5 and 0xFFFFFFFF
        t8 = ((a1 shl 13) or (b1 shr 19)) and 0xFFFFFFFF
        t9 = ((b1 shl 13) or (a1 shr 19)) and 0xFFFFFFFF
        t10 = t8 xor t6
        t11 = t9 xor t7
        t12 = b2 + t4
        t13 = ((a2 + t3) + (t12 shr 32)) and 0xFFFFFFFF
        t14 = t12 and 0xFFFFFFFF
        t15 = ((t3 shl 16) or (t4 shr 16)) and 0xFFFFFFFF
        t16 = ((t4 shl 16) or (t3 shr 16)) and 0xFFFFFFFF
        t17 = t15 xor t13
        t18 = t16 xor t14
        t19 = t6 + t18
        t20 = ((t7 + t17) + (t19 shr 32)) and 0xFFFFFFFF
        t21 = t19 and 0xFFFFFFFF
        t22 = ((t17 shl 21) or (t18 shr 11)) and 0xFFFFFFFF
        t23 = ((t18 shl 21) or (t17 shr 11)) and 0xFFFFFFFF
        t24 = t22 xor t20
        t25 = t23 xor t21
        t26 = t14 + t11
        t27 = ((t13 + t10) + (t26 shr 32)) and 0xFFFFFFFF
        t28 = t26 and 0xFFFFFFFF
        t29 = ((t10 shl 17) or (t11 shr 15)) and 0xFFFFFFFF
        t30 = ((t11 shl 17) or (t10 shr 15)) and 0xFFFFFFFF
        t31 = t29 xor t27
        t32 = t30 xor t28
        t33 = t20 xor t2
        t34 = t21 xor t1
        t35 = t27 xor 255
        t36 = t34 + t32
        t37 = ((t33 + t31) + (t36 shr 32)) and 0xFFFFFFFF
        t38 = t36 and 0xFFFFFFFF
        t39 = ((t31 shl 13) or (t32 shr 19)) and 0xFFFFFFFF
        t40 = ((t32 shl 13) or (t31 shr 19)) and 0xFFFFFFFF
        t41 = t39 xor t37
        t42 = t40 xor t38
        t43 = t35 + t25
        t44 = ((t28 + t24) + (t43 shr 32)) and 0xFFFFFFFF
        t45 = t43 and 0xFFFFFFFF
        t46 = ((t24 shl 16) or (t25 shr 16)) and 0xFFFFFFFF
        t47 = ((t25 shl 16) or (t24 shr 16)) and 0xFFFFFFFF
        t48 = t46 xor t44
        t49 = t47 xor t45
        t50 = t37 + t49
        t51 = ((t38 + t48) + (t50 shr 32)) and 0xFFFFFFFF
        t52 = t50 and 0xFFFFFFFF
        t53 = ((t48 shl 21) or (t49 shr 11)) and 0xFFFFFFFF
        t54 = ((t49 shl 21) or (t48 shr 11)) and 0xFFFFFFFF
        t55 = t53 xor t51
        t56 = t54 xor t52
        t57 = t45 + t42
        t58 = ((t44 + t41) + (t57 shr 32)) and 0xFFFFFFFF
        t59 = t57 and 0xFFFFFFFF
        t60 = ((t41 shl 17) or (t42 shr 15)) and 0xFFFFFFFF
        t61 = ((t42 shl 17) or (t41 shr 15)) and 0xFFFFFFFF
        t62 = t60 xor t58
        t63 = t61 xor t59
        t64 = t52 + t63
        t65 = ((t51 + t62) + (t64 shr 32)) and 0xFFFFFFFF
        t66 = t64 and 0xFFFFFFFF
        t67 = ((t62 shl 13) or (t63 shr 19)) and 0xFFFFFFFF
        t68 = ((t63 shl 13) or (t62 shr 19)) and 0xFFFFFFFF
        t69 = t67 xor t65
        t70 = t68 xor t66
        t71 = t58 + t56
        t72 = ((t59 + t55) + (t71 shr 32)) and 0xFFFFFFFF
        t73 = t71 and 0xFFFFFFFF
        t74 = ((t55 shl 16) or (t56 shr 16)) and 0xFFFFFFFF
        t75 = ((t56 shl 16) or (t55 shr 16)) and 0xFFFFFFFF
        t76 = t74 xor t72
        t77 = t75 xor t73
        t78 = t65 + t77
        t79 = ((t66 + t76) + (t78 shr 32)) and 0xFFFFFFFF
        t80 = t78 and 0xFFFFFFFF
        t81 = ((t76 shl 21) or (t77 shr 11)) and 0xFFFFFFFF
        t82 = ((t77 shl 21) or (t76 shr 11)) and 0xFFFFFFFF
        t83 = t81 xor t79
        t84 = t82 xor t80
        t85 = t73 + t70
        t86 = ((t72 + t69) + (t85 shr 32)) and 0xFFFFFFFF
        t87 = t85 and 0xFFFFFFFF
        t88 = ((t69 shl 17) or (t70 shr 15)) and 0xFFFFFFFF
        t89 = ((t70 shl 17) or (t69 shr 15)) and 0xFFFFFFFF
        t90 = t88 xor t86
        t91 = t89 xor t87
        t92 = t80 + t91
        t93 = ((t79 + t90) + (t92 shr 32)) and 0xFFFFFFFF
        t94 = t92 and 0xFFFFFFFF
        t95 = ((t90 shl 13) or (t91 shr 19)) and 0xFFFFFFFF
        t96 = ((t91 shl 13) or (t90 shr 19)) and 0xFFFFFFFF
        t97 = t95 xor t93
        t98 = t96 xor t94
        t99 = t86 + t84
        t100 = ((t87 + t83) + (t99 shr 32)) and 0xFFFFFFFF
        t101 = t99 and 0xFFFFFFFF
        t102 = ((t83 shl 16) or (t84 shr 16)) and 0xFFFFFFFF
        t103 = ((t84 shl 16) or (t83 shr 16)) and 0xFFFFFFFF
        t104 = t102 xor t100
        t105 = t103 xor t101
        t106 = t93 + t105
        t107 = ((t94 + t104) + (t106 shr 32)) and 0xFFFFFFFF
        t108 = t106 and 0xFFFFFFFF
        t109 = ((t104 shl 21) or (t105 shr 11)) and 0xFFFFFFFF
        t110 = ((t105 shl 21) or (t104 shr 11)) and 0xFFFFFFFF
        t111 = t109 xor t107
        t112 = t110 xor t108
        t113 = t101 + t98
        t114 = ((t100 + t97) + (t113 shr 32)) and 0xFFFFFFFF
        t115 = t113 and 0xFFFFFFFF
        t116 = ((t97 shl 17) or (t98 shr 15)) and 0xFFFFFFFF
        t117 = ((t98 shl 17) or (t97 shr 15)) and 0xFFFFFFFF
        t118 = t116 xor t114
        t119 = t117 xor t115
        t120 = ((t108 xor t119) xor t114) xor t112
        t121 = ((t107 xor t118) xor t115) xor t111
        hs pick want t121 t120

-- v0..v3 from the key (k0 = bytes 0-7, k1 = bytes 8-15, little-endian) and the constants "somepseudorandomlygeneratedbytes".
fn :: siphash13 start String String Int Int Int => Int
      siphash13 start key s from to want =
        k0l = hs key word key 0
        k0h = hs key word key 4
        k1l = hs key word key 8
        k1h = hs key word key 12
        n   = to - from
        siphash13 loop s from (from + ((n shr 3) shl 3)) to n want (k0h xor 0x736f6d65) (k0l xor 0x70736575) (k1h xor 0x646f7261) (k1l xor 0x6e646f6d) (k0h xor 0x6c796765) (k0l xor 0x6e657261) (k1h xor 0x74656462) (k1l xor 0x79746573)

-- @implements FR-HASH-001
-- @implements API-HASH-001
-- SipHash-1-3 of the bytes `from` (included) to `to` (excluded) of `data`, with a 16-byte key: 64 bits.
-- A key that is not 16 bytes, or a range outside `data`, gives 0.
fn :: siphash13 range String String Int Int => Int
      siphash13 range key data from to =
        | (str len key) != 16 or from < 0 or to < from or to > (str len data) = 0
        | otherwise = siphash13 start key data from to 1

-- @implements FR-HASH-001
-- @implements API-HASH-001
-- The low 32 bits of `siphash13 range`: enough for a table index, and cheaper (it stays a plain Int).
fn :: siphash13 range low String String Int Int => Int
      siphash13 range low key data from to =
        | (str len key) != 16 or from < 0 or to < from or to > (str len data) = 0
        | otherwise = siphash13 start key data from to 0

-- @implements FR-HASH-001
-- @implements API-HASH-001
-- SipHash-1-3 of the whole of `data`.
fn :: siphash13 String String => Int
      siphash13 key data =  siphash13 range key data 0 (str len data)

-- @implements FR-HASH-001
-- @implements API-HASH-001
-- A new random 16-byte key (from the system random source). "" when it cannot be read.
fn :: siphash new key => String
      siphash new key =  hs key of (sys random bytes 16)

fn :: hs key of (Int String) => String
      hs key of (rc, k) =
        | rc == 0 and (str len k) == 16 = k
        | otherwise                     = ""
