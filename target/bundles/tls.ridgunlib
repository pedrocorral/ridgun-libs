      rfc8448 hex "nst"            =  "040000c90000001efad6aac502000000b22c035d829359ee5ff7af4ec900000000262a6494dc486d2c8a34cb33fa90bf" + "1b0070ad3c498883c9367c09a2be785abc55cd226097a3a982117283f82a03a143efd3ff5dd36d64e861be7fd61d2827" + "db279cce145077d454a3664d4e6da4d29ee03725a6a4dafcd0fc67d2aea70529513e3da2677fa5906c5b3f7d8f92f228" + "bda40dda721470f9fbf297b5aea617646fac5c03272e970727c621a79141ef5f7de6505e5bfbc388e93343694093934a" + "e4d3570008002a000400000400"
      rfc8448 hex "nst record"     =  "17030300de3a6b8f90414a97d6959c3487680de5134a2b240e6cffac116e95d41d6af8f6b580dcf3d11d63c758db289a" + "015940252f55713e061dc13e078891a38efbcf5753ad8ef170ad3c7353d16d9da773b9ca7f2b9fa1b6c0d4a3d03f75e0" + "9c30ba1e62972ac46f75f7b981be63439b2999ce13064615139891d5e4c5b406f16e3fc181a77ca475840025db2f0a77" + "f81b5ab05b94c01346755f69232c86519d86cbeeac87aac347d143f9605d64f650db4d023e70e952ca49fe5137121c74" + "bc2697687e248746d6df353005f3bce18696129c8153556b3b6c6779b37bf15985684f"
      rfc8448 hex "c app plain"    =  "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f" + "3031"
      rfc8448 hex "c app record"   =  "1703030043a23f7054b62c94d0affafe8228ba55cbefacea42f914aa66bcab3f2b9819a8a5b46b395bd54a9a20441e2b" + "62974e1f5a6292a2977014bd1e3deae63aeebb21694915e4"
      rfc8448 hex "s app plain"    =  "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f" + "3031"
      rfc8448 hex "s app record"   =  "17030300432e937e11ef4ac740e538ad36005fc4a46932fc3225d05f82aa1b36e30efaf97d90e6dffc602dcb501a59a8" + "fcc49c4bf2e5f0a21c0047c2abf332540dd032e167c2955d"
      rfc8448 hex "c alert record" =  "1703030013c9872760655666b74d7ff1153efd6db6d0b0e3"
      rfc8448 hex "s alert plain"  =  "0100"
      rfc8448 hex "s alert record" =  "1703030013b58fd67166ebf599d24720cfbe7efa7a8864a9"
      rfc8448 hex _                  =  ""

fn :: rfc8448 v String => String
      rfc8448 v name   =  hex to byte str (rfc8448 hex name)

fn :: tls check [String] String Bool => [String]
      tls check acc      name   ok   =
        | ok        = acc
        | otherwise = acc :: [name]

fn :: rfc8448 open String String String Int => Int Int String
      rfc8448 open rec    key    iv     seq =  tls13 open record 4865 key iv seq (tls rest rec 5)

-- Names of the RFC 8448 checks that fail (empty list = all pass).
-- @implements FR-TLS-001
fn :: tls13 rfc8448 checks => [String]
      tls13 rfc8448 checks =
        tr1                  = (rfc8448 v "ch") + (rfc8448 v "sh")
        shared               = x25519 (rfc8448 v "c priv") (rfc8448 v "s pub")
        hsec                 = tls13 hs secret shared
        c_hs                 = derive secret hsec "c hs traffic" tr1
        s_hs                 = derive secret hsec "s hs traffic" tr1
        skey                 = tls13 key s_hs 16
        siv                  = tls13 iv s_hs
        rc1, t1, plain       = rfc8448 open (rfc8448 v "s hs record") skey siv 0
        l1                   = hs msg len plain
        ee                   = tls sub plain 0 l1
        r1                   = tls rest plain l1
        l2                   = hs msg len r1
        cert                 = tls sub r1 0 l2
        r2                   = tls rest r1 l2
        l3                   = hs msg len r2
        cv                   = tls sub r2 0 l3
        sfin                 = tls rest r2 l3
        ders                 = tls13 cert list cert
        ok_leaf, leaf        = x509 parse cert (c nth str ders 0)
        tr_cert              = tr1 + ee + cert
        cv_ok                = tls verify scheme (c nth str ders 0) (tls u16 cv 4) (tls13 cv content tr_cert) (tls sub cv 8 (tls u16 cv 6)) True
        tr_cv                = tr_cert + cv
        tr_sfin              = tr_cv + sfin
        master               = tls13 master secret hsec
        c_ap                 = derive secret master "c ap traffic" tr_sfin
        s_ap                 = derive secret master "s ap traffic" tr_sfin
        cfin                 = tls hs msg 20 (tls13 finished mac c_hs tr_sfin)
        cfin_rec             = tls13 seal record 4865 (tls13 key c_hs 16) (tls13 iv c_hs) 0 22 cfin
        sak                  = tls13 key s_ap 16
        sai                  = tls13 iv s_ap
        cak                  = tls13 key c_ap 16
        cai                  = tls13 iv c_ap
        rc2, t2, nst         = rfc8448 open (rfc8448 v "nst record") sak sai 0
        rc3, t3, sapp        = rfc8448 open (rfc8448 v "s app record") sak sai 1
        rc4, t4, salert      = rfc8448 open (rfc8448 v "s alert record") sak sai 2
        []
          -> tls check "x25519 shared secret" (shared == (rfc8448 v "ikm"))
          -> tls check "handshake secret" (hsec == (rfc8448 v "hs secret"))
          -> tls check "client handshake traffic secret" (c_hs == (rfc8448 v "c hs"))
          -> tls check "server handshake traffic secret" (s_hs == (rfc8448 v "s hs"))
          -> tls check "server handshake key" (skey == (rfc8448 v "s hs key"))
          -> tls check "server handshake iv" (siv == (rfc8448 v "s hs iv"))
          -> tls check "server handshake record decrypts" (rc1 == 0 and t1 == 22 and plain == (rfc8448 v "s hs plain"))
          -> tls check "EncryptedExtensions" (ee == (rfc8448 v "ee"))
          -> tls check "Certificate" (cert == (rfc8448 v "cert"))
          -> tls check "CertificateVerify message" (cv == (rfc8448 v "cv"))
          -> tls check "server Finished message" (sfin == (rfc8448 v "s fin"))
          -> tls check "certificate parses as 1024-bit RSA" (ok_leaf and (key_alg leaf) == "rsa" and (str len (pubkey_bytes leaf)) == 128)
          -> tls check "1024-bit CertificateVerify rejected by 2048-bit floor (ADR-0005)" (not cv_ok)
          -> tls check "server Finished verifies" (ct equal (tls rest sfin 4) (tls13 finished mac s_hs tr_cv))
          -> tls check "master secret" (master == (rfc8448 v "master"))
          -> tls check "client application traffic secret" (c_ap == (rfc8448 v "c ap"))
          -> tls check "server application traffic secret" (s_ap == (rfc8448 v "s ap"))
          -> tls check "client Finished message" (cfin == (rfc8448 v "c fin"))
          -> tls check "client Finished record" (cfin_rec == (rfc8448 v "c fin record"))
          -> tls check "server application key" (sak == (rfc8448 v "s ap key"))
          -> tls check "server application iv" (sai == (rfc8448 v "s ap iv"))
          -> tls check "client application key" (cak == (rfc8448 v "c ap key"))
          -> tls check "client application iv" (cai == (rfc8448 v "c ap iv"))
          -> tls check "NewSessionTicket record decrypts" (rc2 == 0 and t2 == 22 and nst == (rfc8448 v "nst"))
          -> tls check "client application data record" ((tls13 seal record 4865 cak cai 0 23 (rfc8448 v "c app plain")) == (rfc8448 v "c app record"))
          -> tls check "server application data record decrypts" (rc3 == 0 and t3 == 23 and sapp == (rfc8448 v "s app plain"))
          -> tls check "client close_notify record" ((tls13 seal record 4865 cak cai 1 21 ((byte str 1) + (byte str 0))) == (rfc8448 v "c alert record"))
          -> tls check "server close_notify record decrypts" (rc4 == 0 and t4 == 21 and salert == (rfc8448 v "s alert plain"))

-- @implements FR-TLS-001
-- @implements API-TLS-001
fn :: tls13 rfc8448 self test => Bool
      tls13 rfc8448 self test =  tls no names (tls13 rfc8448 checks)

fn :: tls no names [String] => Bool
      tls no names []    =  True
      tls no names (_:_) =  False
