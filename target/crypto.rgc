        b2 = (x / 65536) % 2
        b3 = (x / 16777216) % 2
        b4 = (x / 4294967296) % 2
        b5 = (x / 1099511627776) % 2
        b6 = (x / 281474976710656) % 2
        b7 = (x / 72057594037927936) % 2
