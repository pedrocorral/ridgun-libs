-- @implements FR-CRYPTO-004
-- @implements API-CRYPTO-001
-- @implements DM-Tensor
fn :: f blamka U64 U64 => U64
      f blamka x   y   =  x + y + 2 * ((x and 0xFFFFFFFF) * (y and 0xFFFFFFFF))

-- @implements FR-CRYPTO-004
-- @implements API-CRYPTO-001
-- @implements DM-Tensor
fn :: blamka g U64 U64 U64 U64 => U64 U64 U64 U64
