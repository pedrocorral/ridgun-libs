-- src/main/ridgun/lib/list.rg
-- Pure-Ridgun List Operations, O(N log N) Mergesort & Key-Value Map Library (LIST)
-- @implements FR-LIST-001
-- @implements API-LIST-001
-- @mitigates VUL-INPUT-001
-- ============================================================

-- ── List Length & Emptiness ──────────────────────────────────

-- @implements FR-LIST-001
-- @implements API-LIST-001
fn :: list len [Int]    => Int
      list len []       =  0
      list len (_:rest) =  1 + (list len rest)

-- @implements FR-LIST-001
-- @implements API-LIST-001
fn :: list str len [String] => Int
      list str len []       =  0
      list str len (_:rest) =  1 + (list str len rest)

-- @implements FR-LIST-001
-- @implements API-LIST-001
fn :: list is empty [Int] => Bool
      list is empty []    =  True
      list is empty _     =  False

-- @implements FR-LIST-001
-- @implements API-LIST-001
fn :: list str is empty [String] => Bool
      list str is empty []       =  True
      list str is empty _        =  False

-- ── Indexing, Head & Last ────────────────────────────────────

-- @implements FR-LIST-001
-- @implements API-LIST-001
-- @mitigates VUL-INPUT-001
fn :: list nth or [Int] Int Int => Int
      list nth or [] _ fallback = fallback
      list nth or (x:rest) idx fallback =
        | idx < 0   = fallback
        | idx == 0  = x
        | otherwise = list nth or rest (idx - 1) fallback

-- @implements FR-LIST-001
-- @implements API-LIST-001
fn :: list nth [Int] Int => Int
      list nth xs    idx =  list nth or xs idx 0

-- @implements FR-LIST-001
-- @implements API-LIST-001
-- @mitigates VUL-INPUT-001
fn :: list str nth or [String] Int String => String
      list str nth or [] _ fallback = fallback
      list str nth or (x:rest) idx fallback =
        | idx < 0   = fallback
        | idx == 0  = x
        | otherwise = list str nth or rest (idx - 1) fallback

-- @implements FR-LIST-001
-- @implements API-LIST-001
fn :: list str nth [String] Int => String
      list str nth xs       idx =  list str nth or xs idx ""

-- @implements FR-LIST-001
-- @implements API-LIST-001
fn :: list head [Int] Int      => Int
      list head []    fallback =  fallback
      list head (x:_) _        =  x

-- @implements FR-LIST-001
-- @implements API-LIST-001
fn :: list last [Int]    Int      => Int
      list last []       fallback =  fallback
      list last (x:[])   _        =  x
      list last (_:rest) fallback =  list last rest fallback

-- ── Slicing (`take`, `drop`, `slice`) & Reversal ─────────────

-- @implements FR-LIST-001
-- @implements API-LIST-001
-- @mitigates VUL-INPUT-001
fn :: list take [Int]    Int => [Int]
      list take []       _   =  []
      list take (x:rest) n   =
        | n <= 0    = []
        | otherwise = [x] :: (list take rest (n - 1))

-- @implements FR-LIST-001
-- @implements API-LIST-001
-- @mitigates VUL-INPUT-001
fn :: list str take [String] Int => [String]
      list str take []       _   =  []
      list str take (x:rest) n   =
        | n <= 0    = []
        | otherwise = [x] :: (list str take rest (n - 1))

-- @implements FR-LIST-001
-- @implements API-LIST-001
-- @mitigates VUL-INPUT-001
fn :: list drop [Int]    Int => [Int]
      list drop []       _   =  []
      list drop (x:rest) n   =
        | n <= 0    = [x] :: rest
        | otherwise = list drop rest (n - 1)

-- @implements FR-LIST-001
-- @implements API-LIST-001
-- @mitigates VUL-INPUT-001
fn :: list str drop [String] Int => [String]
      list str drop []       _   =  []
      list str drop (x:rest) n   =
        | n <= 0    = [x] :: rest
        | otherwise = list str drop rest (n - 1)

fn :: l clamp nonneg Int => Int
      l clamp nonneg x   =
        | x < 0     = 0
        | otherwise = x

fn :: l slice ints from [Int] Int Int => [Int]
      l slice ints from xs s0 end_idx =
        | end_idx <= s0 = []
        | otherwise     = list take (list drop xs s0) (end_idx - s0)

-- @implements FR-LIST-001
-- @implements API-LIST-001
fn :: list slice [Int] Int   Int     => [Int]
      list slice xs    start end_idx =  l slice ints from xs (l clamp nonneg start) end_idx

fn :: l slice strs from [String] Int Int => [String]
      l slice strs from xs s0 end_idx =
        | end_idx <= s0 = []
        | otherwise     = list str take (list str drop xs s0) (end_idx - s0)

-- @implements FR-LIST-001
-- @implements API-LIST-001
fn :: list str slice [String] Int Int => [String]
      list str slice xs start end_idx = l slice strs from xs (l clamp nonneg start) end_idx

fn :: l rev ints [Int]    [Int] => [Int]
      l rev ints []       acc   =  acc
      l rev ints (x:rest) acc   =  l rev ints rest ([x] :: acc)

-- @implements FR-LIST-001
-- @implements API-LIST-001
fn :: list reverse [Int] => [Int]
      list reverse xs    =  l rev ints xs []

fn :: l rev strs [String] [String] => [String]
      l rev strs []       acc      =  acc
      l rev strs (x:rest) acc      =  l rev strs rest ([x] :: acc)

-- @implements FR-LIST-001
-- @implements API-LIST-001
fn :: list str reverse [String] => [String]
      list str reverse xs       =  l rev strs xs []

-- ── Range & Replication ──────────────────────────────────────

-- @implements FR-LIST-001
-- @implements API-LIST-001
-- @mitigates VUL-INPUT-001
fn :: list range step Int Int Int => [Int]
      list range step cur hi step =
        | step == 0             = []
        | step > 0 and cur > hi = []
        | step < 0 and cur < hi = []
        | otherwise             = [cur] :: (list range step (cur + step) hi step)

-- @implements FR-LIST-001
-- @implements API-LIST-001
fn :: list range Int Int => [Int]
      list range lo  hi  =
        | lo > hi   = []
        | otherwise = list range step lo hi 1

-- @implements FR-LIST-001
-- @implements API-LIST-001
-- @mitigates VUL-INPUT-001
fn :: list replicate Int Int => [Int]
      list replicate n   val =
        | n <= 0    = []
        | otherwise = [val] :: (list replicate (n - 1) val)

-- ── Search, Count & Deduplication ────────────────────────────

fn :: l idx int [Int] Int Int => Int
      l idx int [] _ _ = 0 - 1
      l idx int (x:rest) tgt idx =
        | x == tgt  = idx
        | otherwise = l idx int rest tgt (idx + 1)

-- @implements FR-LIST-001
-- @implements API-LIST-001
fn :: list index of [Int] Int => Int
      list index of xs    tgt =  l idx int xs tgt 0

-- @implements FR-LIST-001
-- @implements API-LIST-001
fn :: list contains [Int] Int => Bool
      list contains xs    tgt =  (list index of xs tgt) >= 0

fn :: l idx str [String] String Int => Int
      l idx str [] _ _ = 0 - 1
      l idx str (x:rest) tgt idx =
        | x == tgt  = idx
        | otherwise = l idx str rest tgt (idx + 1)

-- @implements FR-LIST-001
-- @implements API-LIST-001
fn :: list str index of [String] String => Int
      list str index of xs tgt = l idx str xs tgt 0

-- @implements FR-LIST-001
-- @implements API-LIST-001
fn :: list str contains [String] String => Bool
      list str contains xs       tgt    =  (list str index of xs tgt) >= 0

-- @implements FR-LIST-001
-- @implements API-LIST-001
fn :: list count [Int]    Int => Int
      list count []       _   =  0
      list count (x:rest) tgt =
        | x == tgt  = 1 + (list count rest tgt)
        | otherwise = list count rest tgt

-- @implements FR-LIST-001
-- @implements API-LIST-001
fn :: list str count [String] String => Int
      list str count []       _      =  0
      list str count (x:rest) tgt    =
        | x == tgt  = 1 + (list str count rest tgt)
        | otherwise = list str count rest tgt

fn :: l dedup ints [Int]    [Int] => [Int]
      l dedup ints []       seen  =  list reverse seen
      l dedup ints (x:rest) seen  =
        | list contains seen x = l dedup ints rest seen
        | otherwise            = l dedup ints rest ([x] :: seen)

-- @implements FR-LIST-001
-- @implements API-LIST-001
fn :: list dedup [Int] => [Int]
      list dedup xs    =  l dedup ints xs []

fn :: l dedup strs [String] [String] => [String]
      l dedup strs []       seen     =  list str reverse seen
      l dedup strs (x:rest) seen     =
        | list str contains seen x = l dedup strs rest seen
        | otherwise                = l dedup strs rest ([x] :: seen)

-- @implements FR-LIST-001
-- @implements API-LIST-001
fn :: list str dedup [String] => [String]
      list str dedup xs       =  l dedup strs xs []

-- ── Deterministic O(N log N) Mergesort ───────────────────────

fn :: l merge ints [Int]    [Int]    => [Int]
      l merge ints []       ys       =  ys
      l merge ints xs       []       =  xs
      l merge ints (x:xrst) (y:yrst) =
        | x <= y    = [x] :: (l merge ints xrst ([y] :: yrst))
        | otherwise = [y] :: (l merge ints ([x] :: xrst) yrst)

fn :: l sort ints len [Int] Int => [Int]
      l sort ints len xs n =
        | n <= 1 = xs
        | otherwise =
          mid  = n / 2
          left = list take xs mid
          rght = list drop xs mid
          l merge ints (l sort ints len left mid) (l sort ints len rght (n - mid))

-- @implements FR-LIST-001
-- @implements API-LIST-001
fn :: list sort [Int] => [Int]
      list sort xs    =  l sort ints len xs (list len xs)

-- @implements FR-LIST-001
-- @implements API-LIST-001
fn :: list is sorted [Int]      => Bool
      list is sorted []         =  True
      list is sorted (_:[])     =  True
      list is sorted (a:b:rest) =
        | a > b     = False
        | otherwise = list is sorted ([b] :: rest)

fn :: l str le loop String String Int Int Int => Bool
      l str le loop a b idx la lb =
        | idx >= la and idx >= lb                   = True
        | idx >= la                                 = True
        | idx >= lb                                 = False
        | (str char at a idx) < (str char at b idx) = True
        | (str char at a idx) > (str char at b idx) = False
        | otherwise                                 = l str le loop a b (idx + 1) la lb

fn :: l str le String String => Bool
      l str le a      b      =  l str le loop a b 0 (str len a) (str len b)

fn :: l merge strs [String] [String] => [String]
      l merge strs []       ys       =  ys
      l merge strs xs       []       =  xs
      l merge strs (x:xrst) (y:yrst) =
        | l str le x y = [x] :: (l merge strs xrst ([y] :: yrst))
        | otherwise    = [y] :: (l merge strs ([x] :: xrst) yrst)

fn :: l sort strs len [String] Int => [String]
      l sort strs len xs n =
        | n <= 1 = xs
        | otherwise =
          mid  = n / 2
          left = list str take xs mid
          rght = list str drop xs mid
          l merge strs (l sort strs len left mid) (l sort strs len rght (n - mid))

-- @implements FR-LIST-001
-- @implements API-LIST-001
fn :: list str sort [String] => [String]
      list str sort xs       =  l sort strs len xs (list str len xs)

-- ── Associative Key-Value Map (`[(String, String)]`) ─────────

fn :: l kv key (String String) => String
      l kv key (k, _)          =  k

fn :: l kv val (String String) => String
      l kv val (_, v)          =  v

-- @implements FR-LIST-001
-- @implements API-LIST-001
fn :: kv empty => [String String]
      kv empty =  []

-- @implements FR-LIST-001
-- @implements API-LIST-001
fn :: kv len [String String] => Int
      kv len []              =  0
      kv len (_:rest)        =  1 + (kv len rest)

-- @implements FR-LIST-001
-- @implements API-LIST-001
fn :: kv has [String String] String => Bool
      kv has []              _      =  False
      kv has (pair:rest)     key    =
        | (l kv key pair) == key = True
        | otherwise              = kv has rest key

-- @implements FR-LIST-001
-- @implements API-LIST-001
fn :: kv get or [String String] String String => String
      kv get or [] _ fallback = fallback
      kv get or (pair:rest) key fallback =
        | (l kv key pair) == key = l kv val pair
        | otherwise              = kv get or rest key fallback

-- @implements FR-LIST-001
-- @implements API-LIST-001
fn :: kv get [String String] String => String
      kv get pairs           key    =  kv get or pairs key ""

-- @implements FR-LIST-001
-- @implements API-LIST-001
fn :: kv put [String String] String String => [String String]
      kv put []              key    val    =  [(key, val)]
      kv put (pair:rest)     key    val    =
        | (l kv key pair) == key = [(key, val)] :: rest
        | otherwise              = [pair] :: (kv put rest key val)

-- @implements FR-LIST-001
-- @implements API-LIST-001
fn :: kv remove [String String] String => [String String]
      kv remove []              _      =  []
      kv remove (pair:rest)     key    =
        | (l kv key pair) == key = kv remove rest key
        | otherwise              = [pair] :: (kv remove rest key)

-- @implements FR-LIST-001
-- @implements API-LIST-001
fn :: kv keys [String String] => [String]
      kv keys []              =  []
      kv keys (pair:rest)     =  [(l kv key pair)] :: (kv keys rest)

-- @implements FR-LIST-001
-- @implements API-LIST-001
fn :: kv values [String String] => [String]
      kv values []              =  []
      kv values (pair:rest)     =  [(l kv val pair)] :: (kv values rest)

-- @implements FR-LIST-001
-- @implements API-LIST-001
fn :: kv merge [String String] [String String] => [String String]
      kv merge base            []              =  base
      kv merge base            (pair:rest)     =
        kv merge (kv put base (l kv key pair) (l kv val pair)) rest
